@inherits LayoutComponentBase
@inject GoogleDriveService GoogleDriveService
@inject DatabaseService DatabaseService
@inject IDialogService DialogService
@inject LicenseService LicenseService
@inject NavigationManager NavigationManager

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6" Class="ml-3">@businessName</MudText>
        <MudSpacer />
        @if (DeviceInfo.Platform != DevicePlatform.Android)
        {
            <div style="width: 300px; margin-right: 16px;">
                <MudAutocomplete @ref="searchAutocomplete" T="Kuyumcu.Models.Customer" Placeholder="Müşteri ara..." Variant="Variant.Outlined" Margin="Margin.Dense"
                    SearchFunc="@SearchCustomers" ToStringFunc="@(e => e == null ? null : e.Name)"
                    ValueChanged="OnCustomerSelected" AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start"
                    Clearable="true" Dense="true" MaxItems="10" MinCharacters="1" Style="background: white; border-radius: 4px;" />
            </div>
            @if (licenseStatus == Models.LicenseStatus.Trial)
            {
                <MudChip T="string" Color="@(remainingDays <= 7 ? Color.Error : Color.Warning)" 
                         Size="Size.Small" 
                         Variant="Variant.Filled"
                         Icon="@Icons.Material.Filled.Timer">
                    Deneme Sürümü — @remainingDays gün kaldı
                </MudChip>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Home" Color="Color.Inherit" Href="/" />
            <MudIconButton Icon="@Icons.Material.Filled.People" Color="Color.Inherit" Href="/customers" />
            <MudIconButton Icon="@Icons.Material.Filled.Receipt" Color="Color.Inherit" Href="/transactions" />
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Backup"
            OnClick="@(() => BackupToGoogleDrive())" Disabled="@(isBackupInProgress || !isGoogleDriveConfigured)">
                @(isBackupInProgress ? "Yedekleniyor..." : "Yedek Al")
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" Href="/settings" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.DataObject" Color="Color.Inherit" Href="/import-data" />
        }

    </MudAppBar>

    <MudMainContent Class="pt-16 px-4">
        @Body
    </MudMainContent>
</MudLayout>

<MudThemeProvider Theme="myCustomTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudScrollToTop>
    <MudFab Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ArrowCircleUp" />
</MudScrollToTop>

@code {
    private bool isBackupInProgress = false;
    private string backupResult = string.Empty;
    private string businessName = "Kuyumcu";
    private bool isGoogleDriveConfigured = false;
    private Models.LicenseStatus licenseStatus = Models.LicenseStatus.Trial;
    private int remainingDays = 30;

    private MudTheme myCustomTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#5851db",
            Secondary = "#833ab4",
            AppbarBackground = "#5851db",
            Background = "#f8f9fa",
            DrawerBackground = "#FFF",
            DrawerText = "rgba(0,0,0, 0.7)",
            Success = "#06d79c"
        },
        Typography = new Typography()
        {
                Default = new DefaultTypography()
                {
                FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" },
                FontSize = "0.875rem",
                FontWeight = "400",
                LineHeight = "1.43",
                LetterSpacing = ".01071em"
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var settings = await DatabaseService.GetSettingsAsync();
        if (!string.IsNullOrWhiteSpace(settings.BusinessName))
        {
            businessName = settings.BusinessName;
        }
        isGoogleDriveConfigured = !string.IsNullOrWhiteSpace(settings.GoogleClientId) 
                                   && !string.IsNullOrWhiteSpace(settings.GoogleClientSecret);

        // Lisans durumunu yükle
        try
        {
            licenseStatus = await LicenseService.GetLicenseStatusAsync();
            if (licenseStatus == Models.LicenseStatus.Trial)
            {
                remainingDays = await LicenseService.GetRemainingTrialDaysAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MainLayout lisans kontrolü hata: {ex.Message}");
        }
    }

    private async Task BackupToGoogleDrive()
    {
        var confirmResult = await DialogService.ShowMessageBox(
          "Emin misiniz?",
          "Yedekleme Alinacak",
          yesText: "Evet",
          noText: "Hayir");

        if (confirmResult == false) return;
        try
        {
            isBackupInProgress = true;
            StateHasChanged();

            backupResult = await GoogleDriveService.BackupDatabaseAsync();

            await DialogService.ShowMessageBox(
                "Yedekleme",
                backupResult,
                yesText: "Tamam");
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBox(
                "Hata",
                $"Yedekleme sirasinda bir hata olustu: {ex.Message}",
                yesText: "Tamam");
        }
        finally
        {
            isBackupInProgress = false;
            StateHasChanged();
        }
    }

    private MudAutocomplete<Kuyumcu.Models.Customer> searchAutocomplete;
    private Kuyumcu.Models.Customer selectedCustomer;

    private async Task<IEnumerable<Kuyumcu.Models.Customer>> SearchCustomers(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return await DatabaseService.GetCustomersPaginationAsync(0, 10, null, null, null);

        var customers = await DatabaseService.GetCustomersPaginationAsync(0, 10, null, null, value);
        return customers;
    }

    private void OnCustomerSelected(Kuyumcu.Models.Customer customer)
    {
        if (customer != null)
        {
            NavigationManager.NavigateTo($"/customer/{customer.Id}");
            if (searchAutocomplete != null)
            {
                searchAutocomplete.ResetAsync();
            }
        }
    }
}
