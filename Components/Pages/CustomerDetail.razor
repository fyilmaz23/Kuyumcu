    private async Task LoadCustomerData()
    {
        isLoading = true;

        customer = await DatabaseService.GetCustomerAsync(CustomerId);
        if (customer != null)
        {
            // Reset the loaded transactions count for a fresh load
            loadedTransactionsCount = new Dictionary<CurrencyType, int>();

            // Get all transactions for the customer
            allTransactions = await DatabaseService.GetCustomerTransactionsAsync(CustomerId);

            if (allTransactions != null)
            {
                // Emanet işlemleri ayrı gösterdiğimiz için ana listeden çıkaralım
                depositTransactions = allTransactions.Where(t => t.IsDeposit).ToList();
                transactions = allTransactions.Where(t => !t.IsDeposit).ToList();
            }
            else
            {
                transactions = new List<Transaction>();
                depositTransactions = new List<Transaction>();
            }

            // Deposit olmayan işlemleri gruplayalım
            transactions = transactions.Where(t => !t.IsDeposit).ToList();

            await GroupTransactions();

            // Önceki ve sonraki müşteri ID'lerini yükle
            previousCustomerId = await DatabaseService.GetPreviousCustomerIdAsync(CustomerId);
            nextCustomerId = await DatabaseService.GetNextCustomerIdAsync(CustomerId);
        }

        isLoading = false;
    }

    private async Task GroupTransactions()
    {
        if (transactions == null || transactions.Count == 0)
        {
            groupedTransactions = new List<TransactionGroup>();
            return;
        }

        // Filter hidden transactions if they should not be shown
        var filteredTransactions = transactions;
        if (!showHiddenTransactions)
        {
            filteredTransactions = transactions.Where(t => !t.IsHidden).ToList();
        }

        // Check if there are any hidden transactions at all
        hasHiddenTransactions = transactions.Any(t => t.IsHidden);

        // Get distinct currency types from the transactions
        var currencyTypes = filteredTransactions.Select(t => t.CurrencyType).Distinct().ToList();

        // Initialize loadedTransactionsCount for currency types if not already set
        foreach (var currencyType in currencyTypes)
        {
            if (!loadedTransactionsCount.ContainsKey(currencyType))
            {
                loadedTransactionsCount[currencyType] = PAGE_SIZE;
            }
        }

        // Group transactions by currency with pagination
        groupedTransactions = new List<TransactionGroup>();

        foreach (var currencyType in currencyTypes)
        {
            // Load only the specified number of transactions for this currency type
            var transactionsForCurrency = await DatabaseService.GetCustomerTransactionsByCurrencyPaginatedAsync(
                CustomerId, currencyType, 0, loadedTransactionsCount[currencyType]);

            // Apply hidden filter if needed
            if (!showHiddenTransactions)
            {
                transactionsForCurrency = transactionsForCurrency.Where(t => !t.IsHidden).ToList();
            }

            // Calculate the total balance for this currency regardless of pagination
            var allTransactionsForCurrency = filteredTransactions.Where(t => t.CurrencyType == currencyType).ToList();
            var balance = allTransactionsForCurrency.Where(t => t.Type == TransactionType.CustomerDebt).Sum(t => t.Amount) -
                          allTransactionsForCurrency.Where(t => t.Type == TransactionType.StoreDebt).Sum(t => t.Amount);

            // Kümülatif kalanı tüm geçmiş üzerinden (kronolojik sırayla) hesapla.
            // Böylece "Daha fazla göster" ile yüklenen sayıdan bağımsız olarak,
            // ekranda görünen her işlemin yanında doğru kümülatif kalan gösterilir.
            var runningBalances = new Dictionary<int, decimal>();
            decimal running = 0m;
            foreach (var t in allTransactionsForCurrency.OrderBy(x => x.Date).ThenBy(x => x.Id))
            {
                running += t.Type == TransactionType.CustomerDebt ? t.Amount : -t.Amount;
                runningBalances[t.Id] = running;
            }

            groupedTransactions.Add(new TransactionGroup
            {
                Key = currencyType,
                Transactions = transactionsForCurrency.OrderBy(x => x.Date).ThenBy(x => x.Id).ToList(),
                Balance = balance,
                RunningBalances = runningBalances
            });
        }

        // Order by currency type
        groupedTransactions = groupedTransactions.OrderBy(g => g.Key.ToString()).ToList();
    }

    private async Task ToggleHiddenTransactions()
    {
        // Only toggle if there are hidden transactions
        if (hasHiddenTransactions)
        {
            showHiddenTransactions = !showHiddenTransactions;
            await GroupTransactions();
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JavaScript fonksiyonlarını tanımla
            await JSRuntime.InvokeVoidAsync("eval", @"
                // Input seçmek için kullanılan fonksiyon
                window.selectInputText = function(id) {
                    var element = document.getElementById(id);
                    if (element) {
                        window.setTimeout(function() {
                            element.focus();
                            element.select();
                        }, 50);
                    }
                };

                // Bir elemanı yumuşak geçişle görünür alanın ortasına kaydırır ve
                // hangi karta gidildiği belli olsun diye kısa süre çerçevesini yakıp söndürür.
                window.scrollElementIntoView = function(id) {
                    var element = document.getElementById(id);
                    if (!element) {
                        return;
                    }

                    element.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'nearest' });

                    // Aynı karta tekrar tıklanırsa animasyon baştan başlasın
                    element.classList.remove('scroll-highlight');
                    void element.offsetWidth;
                    element.classList.add('scroll-highlight');

                    window.setTimeout(function () {
                        element.classList.remove('scroll-highlight');
                    }, 1600);
                };

                // Scroll pozisyonunu kaydetmek için değişkenler
                window.scrollData = {
                    scrollTop: 0,
                    elementY: 0
                };

                // Scroll pozisyonunu kaydet
                window.saveScrollPosition = function(elementId) {
                    window.scrollData.scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                    var element = document.getElementById(elementId);
                    if (element) {
                        window.scrollData.elementY = element.getBoundingClientRect().top;
                    }
                };

                // Scroll pozisyonunu geri yükle
                window.restoreScrollPosition = function(elementId) {
                    setTimeout(function() {
                        var element = document.getElementById(elementId);
                        if (element) {
                            var newY = element.getBoundingClientRect().top;
                            var offset = newY - window.scrollData.elementY;
                            window.scrollTo({
                                top: window.scrollData.scrollTop + offset,
                                behavior: 'auto'
                            });
                        }
                    }, 50);
                };
            ");
        }
        await base.OnAfterRenderAsync(firstRender);
    }

