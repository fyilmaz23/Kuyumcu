    private async Task LoadMoreTransactions(CurrencyType currencyType, string buttonId)
    {
        try
        {
            // Save the current scroll position and button position
            await JSRuntime.InvokeVoidAsync("saveScrollPosition", buttonId);

            // Increase the count of loaded transactions for this currency type
            loadedTransactionsCount[currencyType] += PAGE_SIZE;

            // Reload the grouped transactions with the new counts
            await GroupTransactions();
            StateHasChanged();

            // Restore the scroll position to focus on the button
            await JSRuntime.InvokeVoidAsync("restoreScrollPosition", buttonId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadMoreTransactions error: {ex.Message}");
        }
    }

    /// <summary>
    /// Müşterinin özet bilgilerini (bakiyeler ve emanetler) görsel olarak panoya kopyalar.
    /// Panoya görsel kopyalanamayan platformlarda paylaşım menüsü açılır.
    /// </summary>
    private async Task CopySummaryImage()
    {
        if (customer == null || isCopyingSummary)
        {
            return;
        }

        isCopyingSummary = true;
        try
        {
            var settings = await DatabaseService.GetSettingsAsync();
            var result = await CustomerSummaryImageService.CopySummaryAsync(
                customer, groupedTransactions, depositTransactions, settings?.BusinessName);

            switch (result)
            {
                case CustomerSummaryCopyResult.ImageCopied:
                    Snackbar.Add("Özet görseli panoya kopyalandı. WhatsApp gibi uygulamalara yapıştırabilirsiniz.", Severity.Success);
                    break;
                case CustomerSummaryCopyResult.ImageShared:
                    Snackbar.Add("Özet görseli paylaşıma hazır.", Severity.Success);
                    break;
                case CustomerSummaryCopyResult.TextCopied:
                    Snackbar.Add("Görsel oluşturulamadı, özet metin olarak panoya kopyalandı.", Severity.Warning);
                    break;
                default:
                    Snackbar.Add("Özet kopyalanamadı.", Severity.Error);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Özet kopyalanamadı: {ex.Message}", Severity.Error);
        }
        finally
        {
            isCopyingSummary = false;
        }
    }

