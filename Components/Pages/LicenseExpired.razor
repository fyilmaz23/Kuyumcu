@page "/license-expired"
@inject Services.LicenseService LicenseService
@inject Services.DatabaseService DatabaseService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="min-height: 80vh;">
    <MudPaper Class="pa-8 w-100" Elevation="4" Style="border-top: 4px solid #f44336;">
        <MudStack AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Error" />
            <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Error">
                Deneme Süresi Doldu
            </MudText>
        </MudStack>

        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
            30 günlük deneme süreniz sona erdi. Uygulamayı kullanmaya devam etmek için 
            lütfen bir lisans anahtarı girin.
        </MudText>

        <MudDivider Class="mb-6" />

        @if (isLoading)
        {
            <MudProgressCircular Indeterminate="true" Class="d-block mx-auto my-8" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                <MudText Typo="Typo.body2">
                    Lisans almak için aşağıdaki bilgileri yetkilinize iletin:
                </MudText>
            </MudAlert>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="background-color: #f5f5f5; border-radius: 8px;">
                <MudStack Spacing="2">
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">İş Yeri Adı:</MudText>
                        <MudText Typo="Typo.body2"><strong>@businessName</strong></MudText>
                    </div>
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Cihaz Kimliği:</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Style="font-family: monospace;"><strong>@deviceId</strong></MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" 
                                          OnClick="@(() => CopyToClipboard(deviceId))" 
                                          Title="Kopyala" />
                        </MudStack>
                    </div>
                </MudStack>
            </MudPaper>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-1" /> Lisans Anahtarı
            </MudText>

            <MudTextField @bind-Value="licenseKey"
                          Label="Lisans Anahtarı"
                          Placeholder="KUYM-XXXXX-XXXXX-XXXXX-XXXXX"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.VpnKey"
                          Style="font-family: monospace; letter-spacing: 1px;"
                          Class="mb-4" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       FullWidth="true"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       OnClick="ActivateLicense"
                       Disabled="@(string.IsNullOrWhiteSpace(licenseKey) || isActivating)">
                @(isActivating ? "Doğrulanıyor..." : "Lisansı Etkinleştir")
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private string licenseKey = string.Empty;
    private string businessName = string.Empty;
    private string deviceId = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = true;
    private bool isActivating = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // İş yeri adını al
            var settings = await DatabaseService.GetSettingsAsync();
            businessName = settings.BusinessName;

            // Cihaz kimliğini al
            deviceId = await LicenseService.GetDeviceIdAsync();

            // Lisans durumunu kontrol et — eğer lisanslıysa ana sayfaya yönlendir
            var status = await LicenseService.GetLicenseStatusAsync();
            if (status == Models.LicenseStatus.Licensed)
            {
                NavigationManager.NavigateTo("/");
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LicenseExpired OnInitialized hata: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ActivateLicense()
    {
        errorMessage = string.Empty;
        isActivating = true;
        StateHasChanged();

        try
        {
            var result = await LicenseService.ActivateLicenseAsync(licenseKey);

            if (result.Success)
            {
                await DialogService.ShowMessageBox(
                    "Başarılı! 🎉",
                    result.Message,
                    yesText: "Tamam");

                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Beklenmeyen bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isActivating = false;
            StateHasChanged();
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await Clipboard.Default.SetTextAsync(text);
            await DialogService.ShowMessageBox(
                "Kopyalandı",
                "Cihaz kimliği panoya kopyalandı.",
                yesText: "Tamam");
        }
        catch
        {
            // Clipboard erişimi başarısız olabilir
        }
    }
}
