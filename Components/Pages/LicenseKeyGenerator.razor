@page "/generate-license"
@inject Services.LicenseService LicenseService
@inject Services.DatabaseService DatabaseService
@inject IDialogService DialogService

#if DEBUG

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudPaper Class="pa-6" Elevation="3" Style="border-top: 4px solid #ff9800;">
        <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Warning" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" />
            Lisans Anahtarı Oluşturucu
        </MudText>
        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary" Class="mb-4">
            ⚠️ Bu sayfa sadece geliştirme (DEBUG) modunda görünür.
        </MudText>

        <MudDivider Class="mb-4" />

        <MudTextField @bind-Value="targetDeviceId"
                      Label="Hedef Cihaz Kimliği"
                      Placeholder="Müşterinin Cihaz ID'sini girin"
                      Variant="Variant.Outlined"
                      Style="font-family: monospace;"
                      Class="mb-4" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   FullWidth="true"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Key"
                   OnClick="GenerateKey"
                   Disabled="@(string.IsNullOrWhiteSpace(targetDeviceId))">
            Lisans Anahtarı Oluştur
        </MudButton>

        @if (!string.IsNullOrEmpty(generatedKey))
        {
            <MudDivider Class="my-4" />

            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3">
                Lisans anahtarı başarıyla oluşturuldu!
            </MudAlert>

            <MudPaper Class="pa-4" Elevation="0" Style="background-color: #e8f5e9; border-radius: 8px; text-align: center;">
                <MudText Typo="Typo.h6" Style="font-family: monospace; letter-spacing: 2px; word-break: break-all;">
                    @generatedKey
                </MudText>
            </MudPaper>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-3"
                       StartIcon="@Icons.Material.Filled.ContentCopy"
                       OnClick="CopyKey">
                Kopyala
            </MudButton>
        }

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Bu Cihazın Bilgileri:</MudText>
        <MudPaper Class="pa-3" Elevation="0" Style="background-color: #f5f5f5; border-radius: 8px;">
            <MudText Typo="Typo.body2">Cihaz ID: <strong style="font-family: monospace;">@currentDeviceId</strong></MudText>
        </MudPaper>
    </MudPaper>
</MudContainer>

#else

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="min-height: 80vh;">
    <MudPaper Class="pa-8 w-100" Elevation="3">
        <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Error">
            Bu sayfa sadece geliştirme modunda erişilebilir.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" Href="/">
            Ana Sayfaya Dön
        </MudButton>
    </MudPaper>
</MudContainer>

#endif

@code {
    private string targetDeviceId = string.Empty;
    private string generatedKey = string.Empty;
    private string currentDeviceId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        currentDeviceId = await LicenseService.GetDeviceIdAsync();
        // Kolaylık için hedef cihaz kimliğini mevcut cihazla doldur
        targetDeviceId = currentDeviceId;
    }

    private void GenerateKey()
    {
        if (string.IsNullOrWhiteSpace(targetDeviceId))
            return;

        generatedKey = LicenseService.GenerateLicenseKey(targetDeviceId.Trim().ToUpperInvariant());
        StateHasChanged();
    }

    private async Task CopyKey()
    {
        try
        {
            await Clipboard.Default.SetTextAsync(generatedKey);
            await DialogService.ShowMessageBox(
                "Kopyalandı",
                "Lisans anahtarı panoya kopyalandı.",
                yesText: "Tamam");
        }
        catch
        {
            // Clipboard erişimi başarısız olabilir
        }
    }
}
