@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(MauiProgram).Assembly">
    <Found Context="routeData">
        @if (DeviceInfo.Platform == DevicePlatform.Android)
        {
            if (routeData.PageType != typeof(Pages.ImportData))
            {
                NavigationManager.NavigateTo("import-data");
                return;
            }
        }
        else if (!Preferences.Get("IsSetupCompleted", false) && routeData.PageType != typeof(Pages.Setup))
        {
            NavigationManager.NavigateTo("setup");
            return;
        }
        else if (_licenseExpired 
                 && routeData.PageType != typeof(Pages.LicenseExpired)
                 && routeData.PageType != typeof(Pages.Settings)
                 && routeData.PageType != typeof(Pages.Setup))
        {
            NavigationManager.NavigateTo("license-expired");
            return;
        }

        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            @if (DeviceInfo.Platform == DevicePlatform.Android)
            {
                NavigationManager.NavigateTo("import-data");
                return;
            }

            else
            {
                
            <div class="container text-center mt-5">
                    <h1 class="text-danger">404 - Sayfa Bulunamadı</h1>
                    <p class="lead">Aradığınız sayfa bulunamadı.</p>
                    <a href="/" class="btn btn-primary">Ana Sayfaya Dön</a>
                </div>
            }
            </LayoutView>
        </NotFound>
    </Router>

    @code {
    [Inject]
    private NavigationManager NavigationManager { get; set; }

    [Inject]
    private Services.LicenseService LicenseService { get; set; }

    private bool _licenseExpired = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await LicenseService.GetLicenseStatusAsync();
            _licenseExpired = (status == Models.LicenseStatus.Expired);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Routes lisans kontrolü hata: {ex.Message}");
            _licenseExpired = false; // Hata durumunda engellememe
        }
    }
}
