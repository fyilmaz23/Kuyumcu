@page "/fiyatlar"
@inject BackupStore Store
@inject GoldPriceExportService GoldPrices
@inject PriceBackgroundStore Background
@inject PriceShareService PriceShare

@if (Store.Snapshot is not { } data)
{
    <Welcome />
}
else
{
    var (backgroundImage, backgroundSource) = Background.Resolve(data.Settings.GoldPriceTemplateImage);

    <TopBar Title="Altın fiyatları" Subtitle="@(_updatedAt == null ? GoldPrices.SourceName : $"{GoldPrices.SourceName} · {_updatedAt:HH:mm}")">
        <button class="kd-icon-btn @(_loading ? "spinning" : "")" aria-label="Fiyatları yenile" disabled="@_loading" @onclick="Refresh"><Icon Name="refresh" /></button>
    </TopBar>

    <div class="kd-page">
        @if (_error != null)
        {
            <div class="kd-alert is-error"><Icon Name="warning" /><span>@_error</span></div>
        }

        @* ---------- Paylaş: güncel fiyatlar seçili arka plana yazılır ---------- *@
        @if (_prices is { Count: > 0 })
        {
            <button class="kd-btn kd-btn-primary kd-btn-block kd-btn-lg kd-share-top" disabled="@_busy" @onclick="ShareImage">
                @if (_busy)
                {
                    <span class="kd-spinner"></span><span>Görsel hazırlanıyor…</span>
                }
                else
                {
                    <Icon Name="share" /><span>Fiyat listesini paylaş</span>
                }
            </button>
        }
        else if (_loading)
        {
            <div class="kd-card"><EmptyState Icon="diamond" Title="Fiyatlar getiriliyor…" /></div>
        }

        @* ---------- Arka plan resmi: her paylaşımda liste bunun üzerine yazılır ---------- *@
        <h2 class="kd-section">Arka plan resmi</h2>
        <div class="kd-card kd-bg-card">
            <div class="kd-bg-thumb @(backgroundImage == null ? "is-default" : "")">
                @if (backgroundImage != null)
                {
                    <img src="@ThumbnailUrl(backgroundImage)" alt="Arka plan resmi" />
                }
                else
                {
                    <Icon Name="diamond" />
                }
            </div>
            <div class="kd-bg-main">
                <div class="kd-bg-title">@SourceTitle(backgroundSource)</div>
                <div class="kd-bg-sub">@SourceHint(backgroundSource)</div>
                <div class="kd-bg-actions">
                    <button class="kd-btn kd-btn-ghost small" disabled="@_busy" @onclick="PickBackground">
                        <Icon Name="image" /><span>@(Background.HasPhoneBackground ? "Değiştir" : "Resim seç")</span>
                    </button>
                    @if (Background.HasPhoneBackground)
                    {
                        <button class="kd-btn kd-btn-ghost small danger" disabled="@_busy" @onclick="RemoveBackground">
                            <Icon Name="delete" /><span>Kaldır</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (_prices is { Count: > 0 })
        {
            @if (_previewDataUrl != null)
            {
                <h2 class="kd-section">Paylaşılacak görsel</h2>
                <img class="kd-preview" src="@_previewDataUrl" alt="Altın fiyatı görseli" />
            }

            <h2 class="kd-section">Fiyatlar</h2>
            <div class="kd-card kd-prices">
                <div class="kd-prices-head"><span>Cins</span><span>Alış</span><span>Satış</span></div>
                @foreach (var p in _prices)
                {
                    <div class="kd-prices-row">
                        <span class="kd-prices-name">@p.Type</span>
                        <span class="kd-num">@p.BuyPrice.ToString("N2")</span>
                        <span class="kd-num kd-strong">@p.SellPrice.ToString("N2")</span>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [CascadingParameter(Name = "DataVersion")] public int DataVersion { get; set; }

    private List<GoldPriceDto>? _prices;
    private DateTime? _updatedAt;
    private bool _loading;
    private bool _busy;
    private string? _error;
    private string? _previewDataUrl;

    // Küçük resim her çizimde yeniden kodlanmasın
    private byte[]? _thumbFor;
    private string? _thumbUrl;

    protected override async Task OnInitializedAsync()
    {
        await LoadPrices(forceRefresh: false);
        await RenderPreview();
    }

    private async Task Refresh()
    {
        await LoadPrices(forceRefresh: true);
        await RenderPreview();
    }

    /// <summary>
    /// Fiyatlar herkese açık kaynaktan (elazigaltinfiyatlari.com) gelir; üyelik/şifre gerekmez.
    /// Servis son 5 dakikadaki fiyatları yeniden kullanır; "Yenile" her zaman yeniden çeker.
    /// </summary>
    private async Task LoadPrices(bool forceRefresh)
    {
        if (Connectivity.Current.NetworkAccess != NetworkAccess.Internet)
        {
            _error = "İnternet yok; fiyatlar getirilemedi.";
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            var prices = await Task.Run(() => GoldPrices.GetGoldPricesAsync(forceRefresh));
            if (prices is { Count: > 0 })
            {
                _prices = prices;
                _updatedAt = prices.Max(p => p.UpdateTime);
            }
            else
            {
                _error = $"Fiyatlar alınamadı ({GoldPrices.SourceName}). İnterneti kontrol edip yenileyin.";
            }
        }
        catch (Exception ex)
        {
            _error = "Fiyatlar alınamadı: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Fiyat listesini seçili arka plana yazar; görselin yolunu döndürür (önizlemeyi de günceller).</summary>
    private async Task<string?> RenderImage()
    {
        if (_prices is not { Count: > 0 } || Store.Snapshot == null)
            return null;

        var path = await PriceShare.CreateImageAsync(_prices);
        _previewDataUrl = "data:image/jpeg;base64," + Convert.ToBase64String(await File.ReadAllBytesAsync(path));
        return path;
    }

    private async Task RenderPreview()
    {
        try
        {
            await RenderImage();
        }
        catch (PriceShareException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = "Görsel oluşturulamadı: " + ex.Message;
        }
    }

    private async Task ShareImage()
    {
        _busy = true;
        try
        {
            // Her paylaşımda güncel fiyatlar seçili arka plana yeniden yazılır
            var path = await RenderImage();
            StateHasChanged();
            if (path != null)
                await PriceShare.ShareAsync(path);
        }
        catch (PriceShareException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = "Görsel oluşturulamadı: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PickBackground()
    {
        _busy = true;
        _error = null;
        try
        {
            if (await Background.PickAsync())
            {
                await RenderPreview();
                NativeDialogs.Toast("Arka plan kaydedildi");
            }
        }
        catch (InvalidDataException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = "Resim seçilemedi: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveBackground()
    {
        if (!await NativeDialogs.ConfirmAsync("Arka planı kaldır",
                "Telefonda seçilen arka plan kaldırılır. Paylaşımlarda bilgisayardaki şablon (yoksa sade arka plan) kullanılır.",
                "Kaldır"))
            return;

        Background.Clear();
        await RenderPreview();
    }

    private string ThumbnailUrl(byte[] image)
    {
        if (!ReferenceEquals(image, _thumbFor))
        {
            _thumbFor = image;
            _thumbUrl = "data:image/jpeg;base64," + Convert.ToBase64String(image);
        }
        return _thumbUrl!;
    }

    private static string SourceTitle(PriceBackgroundSource source) => source switch
    {
        PriceBackgroundSource.Phone => "Telefonda seçilen resim",
        PriceBackgroundSource.Desktop => "Bilgisayardaki şablon",
        _ => "Sade arka plan",
    };

    private static string SourceHint(PriceBackgroundSource source) => source switch
    {
        PriceBackgroundSource.Phone => "Her paylaşımda fiyat listesi bu resmin üzerine yazılır.",
        PriceBackgroundSource.Desktop => "Bilgisayarda Ayarlar'dan yüklenen şablon. Telefondan başka bir resim seçebilirsiniz.",
        _ => "Kendi arka plan resminizi seçin; fiyat listesi her paylaşımda onun üzerine yazılır.",
    };
}
