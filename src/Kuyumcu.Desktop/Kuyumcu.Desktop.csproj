<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Windows masaüstü uygulaması: WPF penceresi içinde ortak Blazor arayüzü (Microsoft Store'a MSIX olarak gönderilir) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK sürümü zorunlu: WebView2 SDK'sı .NET 5+ WPF için Microsoft.Windows.SDK.NET projeksiyonunu ister;
         sürümsüz "net10.0-windows" ile uygulama açılışta "Could not load Microsoft.Windows.SDK.NET" hatası verir. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- AppxManifest.xml'deki MinVersion ile aynı (Windows 10 1809) -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Kuyumcu.Desktop</RootNamespace>
    <AssemblyName>KuyumcuDefteri</AssemblyName>
    <ApplicationIcon>Packaging\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Linux/macOS üzerinde de derlenebilsin (CI ve geliştirme için) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Müşteri bilgisayarına ayrıca .NET kurulumu gerekmesin -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF projelerinde System.IO örtük olarak eklenmez -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="MudBlazor" />
    <!-- System.Security.Cryptography.ProtectedData (DPAPI) ve System.Drawing.Common
         Windows + WPF çerçevesinde zaten bulunur; ayrıca paket eklenmez (NU1510). -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuyumcu.Core\Kuyumcu.Core.csproj" />
    <ProjectReference Include="..\Kuyumcu.UI\Kuyumcu.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSIX paketleme dosyaları derleme çıktısına değil, CI'daki paketleme adımına girer -->
    <None Include="Packaging\**" />
    <Content Remove="Packaging\**" />
  </ItemGroup>
</Project>
