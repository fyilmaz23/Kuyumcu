@using Kuyumcu.Stock
@inject StockService Stock
@inject DatabaseService Database
@inject GoldPriceExportService GoldPrices
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@*
    Satış penceresi. Son fiyat = net gram × fiyat listesindeki aynı ayarın satış fiyatı + net gram × işçilik (TL/gr)
    (bkz. Kuyumcu.Stock.SalePrice). Fiyat kendiliğinden yazılır, pazarlıkta değiştirilebilir.
    "Müşteri hesabına yaz" seçilirse mevcut defterde Giden (müşteri borçlu) işlemi oluşturulur;
    defterin kuralları aynen uygulanır: aynı gün mükerrer kontrolü ve kaydetmeden önce onay.
*@

<MudDialog>
    <DialogContent>
        <div class="kd-sale-item mb-4">
            <div>
                <div class="kd-strong">@Lookup.Title(Item)</div>
                <div class="kd-muted" style="font-size:.85rem"><span class="kd-code">@Item.Code</span> · @Item.Karat ayar</div>
            </div>
            <div class="text-right">
                <div class="kd-strong kd-num" style="font-size:1.25rem">@WeightFormat.Gram(Item.WeightMg) gr</div>
                @if (Item.StoneWeightMg > 0)
                {
                    <div class="kd-muted kd-num" style="font-size:.8rem">net @WeightFormat.Gram(Item.NetWeightMg) gr (taş @WeightFormat.Gram(Item.StoneWeightMg))</div>
                }
            </div>
        </div>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal?" Value="unitPrice" ValueChanged="OnUnitPrice" Label="Gram fiyatı (TL)" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Format="N2" HideSpinButtons="true" Min="0"
                                 HelperText="@unitSource" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Refresh"
                                 OnAdornmentClick="@(() => LoadPrices(true))" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" Value="laborPerGram" ValueChanged="OnLabor" Label="İşçilik (TL / gr)" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Format="N2" HideSpinButtons="true" Min="0"
                                 HelperText="@(Lookup.LaborPerGram(Item.CategoryId) > 0 ? $"{Lookup.CategoryName(Item.CategoryId)} varsayılanı" : "Kategoride işçilik tanımlı değil")" />
            </MudItem>
            <MudItem xs="12">
                <PriceQuoteView Quote="quote" PriceTime="priceTime" Warning="@priceWarning" EmptyText="Gram fiyatı girin." />
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="decimal?" Value="price" ValueChanged="OnPrice" Label="Satış fiyatı (TL)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Format="N2" HideSpinButtons="true" Min="0" Class="kd-amount-input"
                                 HelperText="@(priceTouched && quote != null && price != quote.Total ? "Elle değiştirildi (pazarlık)" : "Son fiyat otomatik yazılır; pazarlıkta değiştirebilirsiniz")" />
            </MudItem>
        </MudGrid>

        <div class="kd-credit mt-3 @(onCredit ? "is-on" : "")">
            <MudSwitch T="bool" Value="onCredit" ValueChanged="OnCreditChanged" Color="Color.Error" Label="Müşteri hesabına yaz (veresiye)" />
            @if (onCredit)
            {
                <MudGrid Spacing="2" Class="mt-1">
                    <MudItem xs="12">
                        <MudAutocomplete T="Customer" @bind-Value="customer" Label="Müşteri" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         SearchFunc="SearchCustomers" ToStringFunc="@(c => c?.Name)" MinCharacters="1" MaxItems="10"
                                         ShowProgressIndicator="false" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="CurrencyType" Value="creditCurrency" ValueChanged="OnCreditCurrency" Label="Borç cinsi" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="CurrencyType.TurkishLira">TL</MudSelectItem>
                            <MudSelectItem Value="CurrencyType.Gold22K">22 Ayar (gr)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" @bind-Value="creditAmount" Label="@($"Borç ({creditCurrency.GetSymbol()})")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Format="N2" HideSpinButtons="true" Min="0"
                                         HelperText="@(creditCurrency == CurrencyType.Gold22K ? "satış fiyatı ÷ listedeki 22 ayar satış" : "satış fiyatı")" />
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Class="kd-muted">Müşterinin hesabına <b class="kd-giden">Giden</b> (müşteri borçlu) işlem olarak yazılır.</MudText>
            }
        </div>

        <MudTextField @bind-Value="description" Label="Açıklama (isteğe bağlı)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" MaxLength="120" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">Vazgeç</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sell" OnClick="Save" Disabled="saving">
            Satışı kaydet
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public StockItem Item { get; set; } = default!;
    [Parameter] public StockLookup Lookup { get; set; } = default!;

    private List<GoldPriceDto>? prices;
    private decimal? unitPrice, price, creditAmount;
    private decimal laborPerGram;
    private string? description;
    private string unitSource = "Alınıyor…";
    private bool unitFromList;
    private DateTime? priceTime;
    private string? priceWarning;
    private SalePrice.Quote? quote;
    private bool priceTouched;
    private bool onCredit, saving;
    private Customer? customer;
    private CurrencyType creditCurrency = CurrencyType.TurkishLira;

    private int Milyem => Lookup.Milyem(Item.Karat);

    protected override async Task OnInitializedAsync()
    {
        laborPerGram = Lookup.LaborPerGram(Item.CategoryId);
        await LoadPrices(false);
    }

    private async Task LoadPrices(bool force)
    {
        unitSource = "Alınıyor…";
        // İnternet yoksa son alınan fiyat kullanılır, "güncel olmayabilir" uyarısıyla
        var snapshot = await GoldPrices.GetLatestPricesAsync(force, TimeSpan.FromSeconds(8));
        prices = snapshot?.Prices;
        priceWarning = snapshot?.Warning(DateTime.Now);

        if (SalePrice.UnitPriceFor(Item.Karat, Milyem, prices) is { } unit)
        {
            unitPrice = unit.Price;
            unitFromList = unit.FromList;
            unitSource = $"{unit.Source} · {GoldPrices.SourceName}";
            priceTime = prices?.FirstOrDefault()?.UpdateTime;
        }
        else
        {
            priceWarning = null;
            unitSource = "Canlı fiyat alınamadı, gram fiyatını elle girin";
        }
        Recalculate();
    }

    private void OnUnitPrice(decimal? value)
    {
        unitPrice = value;
        unitFromList = false;
        unitSource = "Elle girildi";
        priceTime = null;
        priceWarning = null;
        Recalculate();
    }

    private void OnLabor(decimal value)
    {
        laborPerGram = Math.Max(0, value);
        Recalculate();
    }

    private void OnPrice(decimal? value)
    {
        price = value;
        priceTouched = true;
        UpdateCreditSuggestion();
    }

    private void Recalculate()
    {
        quote = unitPrice is > 0
            ? SalePrice.Calculate(Item.NetWeightMg, unitPrice.Value, unitFromList ? unitSource : "elle girilen gram fiyatı", unitFromList, laborPerGram)
            : null;
        // Elle pazarlık edilmediyse satış fiyatı son fiyatı izler
        if (!priceTouched)
            price = quote?.Total;
        UpdateCreditSuggestion();
    }

    private void OnCreditChanged(bool value)
    {
        onCredit = value;
        UpdateCreditSuggestion();
    }

    private void OnCreditCurrency(CurrencyType value)
    {
        creditCurrency = value;
        creditAmount = null;
        UpdateCreditSuggestion();
    }

    private void UpdateCreditSuggestion()
    {
        if (!onCredit)
            return;
        if (creditCurrency == CurrencyType.Gold22K)
            creditAmount = price is > 0
                ? SalePrice.To22KGram(price.Value, prices) ?? StockCalculator.Suggest22KGram(Item.NetWeightMg, Milyem, 0, Lookup.Milyem(22))
                : StockCalculator.Suggest22KGram(Item.NetWeightMg, Milyem, 0, Lookup.Milyem(22));
        else if (price is > 0)
            creditAmount = price;
    }

    private async Task<IEnumerable<Customer>> SearchCustomers(string value, CancellationToken token) =>
        await Database.GetCustomersPaginationAsync(0, 10, null, null, string.IsNullOrWhiteSpace(value) ? null : value);

    private string SaleText()
    {
        var text = $"Satış: {Lookup.Title(Item)} {Item.Karat} ayar {WeightFormat.Gram(Item.WeightMg)} gr ({Item.Code})";
        if (!string.IsNullOrWhiteSpace(description))
            text += " - " + description.Trim();
        return text.Length > 255 ? text[..255] : text;
    }

    private async Task Save()
    {
        if (price is < 0) { Snackbar.Add("Satış fiyatı negatif olamaz.", Severity.Warning); return; }

        Transaction? transaction = null;
        if (onCredit)
        {
            if (customer == null) { Snackbar.Add("Müşteri seçin.", Severity.Warning); return; }
            if (creditAmount is not > 0) { Snackbar.Add("Borç tutarı 0'dan büyük olmalı.", Severity.Warning); return; }

            transaction = new Transaction
            {
                CustomerId = customer.Id,
                Amount = Math.Round(creditAmount.Value, 2),
                Type = TransactionType.CustomerDebt,
                CurrencyType = creditCurrency,
                Date = DateTime.Now,
                Description = SaleText()
            };

            // Defterin kuralları: aynı gün mükerrer kontrolü ve kaydetmeden önce onay
            if (!await LedgerConfirm.ConfirmNewAsync(Dialogs, Database, customer, transaction))
                return;
        }

        saving = true;
        try
        {
            if (transaction != null)
                await Database.SaveTransactionAsync(transaction);

            try
            {
                var sold = await Stock.MarkSoldAsync(Item.Id, price is > 0 ? price : null, customer?.Id, transaction?.Id,
                    string.IsNullOrWhiteSpace(description) ? "Satış" : description.Trim());
                MudDialog.Close(DialogResult.Ok(sold));
            }
            catch
            {
                // Satış işaretlenemediyse müşteri hesabına yazılan işlem geri alınır
                if (transaction != null)
                    await Database.DeleteTransactionAsync(transaction);
                throw;
            }
        }
        catch (StockException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            saving = false;
        }
    }

    public static async Task<StockItem?> ShowAsync(IDialogService dialogs, StockItem item, StockLookup lookup)
    {
        var parameters = new DialogParameters<StockSaleDialog> { { x => x.Item, item }, { x => x.Lookup, lookup } };
        var dialog = await dialogs.ShowAsync<StockSaleDialog>("Satış", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        return result is { Canceled: false } ? result.Data as StockItem : null;
    }
}
