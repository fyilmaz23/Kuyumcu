@inherits LayoutComponentBase
@implements IDisposable
@inject DatabaseService DatabaseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject LicenseService LicenseService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AppState AppState
@inject ShortcutService Shortcuts

<MudThemeProvider Theme="KuyumcuTheme.Theme" @bind-IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout>
    @* Masaüstü: tek satır üst menü. Sayfalar ikonla gösterilir, başlıkları üzerine gelince çıkar;
       sol menü yok, içerik ekranın tamamını kullanır. *@
    <MudAppBar Elevation="0" Class="kd-appbar kd-topbar">
        <a href="/" class="kd-topbar-brand" title="@businessName">
            <BrandLogo Class="kd-brand-logo" />
            <span class="kd-brand-name">@businessName</span>
        </a>

        <nav class="kd-topnav" aria-label="Ana menü">
            @foreach (var item in MainNavItems)
            {
                @NavItem(item)
            }
        </nav>

        <div class="kd-search" id="global-search">
            <MudAutocomplete @ref="searchAutocomplete" T="Customer" Placeholder="Müşteri ara…  (Ctrl+K)"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                             SearchFunc="SearchCustomers" ToStringFunc="@(c => c?.Name)"
                             ValueChanged="OnCustomerSelected" Clearable="true" MaxItems="10" MinCharacters="1"
                             AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start"
                             ShowProgressIndicator="false">
                <ItemTemplate Context="c">
                    <div class="d-flex align-center gap-3">
                        <Avatar Name="@c.Name" />
                        <div>
                            <div>@c.Name</div>
                            <div class="kd-muted" style="font-size:.75rem">@c.PhoneNumber.FormatPhoneNumber()</div>
                        </div>
                    </div>
                </ItemTemplate>
                <NoItemsTemplate>
                    <div class="pa-3 kd-muted">Müşteri bulunamadı.</div>
                </NoItemsTemplate>
            </MudAutocomplete>
        </div>

        <MudSpacer />

        <div class="kd-topbar-actions">
            @if (licenseState?.Status == LicenseStatus.Trial)
            {
                <MudTooltip Text="Deneme sürümü — lisans için Ayarlar" Placement="Placement.Bottom">
                    <a class="kd-trial @(licenseState.RemainingTrialDays <= 7 ? "is-urgent" : null)" href="/settings">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" />
                        <span>@licenseState.RemainingTrialDays gün</span>
                    </a>
                </MudTooltip>
            }
            else if (licenseState is { Status: LicenseStatus.Licensed, IsLicenseExpiringSoon: true })
            {
                <MudTooltip Text="@($"Lisans {licenseState.LicenseExpiresOn:dd.MM.yyyy} tarihinde bitiyor — yenilemek için Ayarlar")" Placement="Placement.Bottom">
                    <a class="kd-trial is-urgent" href="/settings">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" />
                        <span>Lisans: @licenseState.DaysUntilLicenseExpiry gün</span>
                    </a>
                </MudTooltip>
            }

            <CloudBackupIndicator />

            <MudTooltip Text="@(isDarkMode ? "Açık tema" : "Koyu tema")" Placement="Placement.Bottom">
                <MudIconButton Icon="@(isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               Class="kd-topbar-icon" OnClick="ToggleDarkMode" aria-label="Temayı değiştir" />
            </MudTooltip>

            @NavItem(SettingsNavItem)

            <MudButton Variant="Variant.Filled" Class="kd-new-customer ml-2"
                       StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="NewCustomer">
                Yeni Müşteri
            </MudButton>
        </div>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<MudScrollToTop>
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" />
</MudScrollToTop>

@code {
    // Menü sırası Alt+1..4 kısayollarını da belirler (app.js, .kd-topnav-item sırasına bakar)
    private sealed record NavEntry(string Title, string Href, string Icon, NavLinkMatch Match, string Shortcut);

    private static readonly NavEntry[] MainNavItems =
    [
        new("Ana Sayfa", "/", Icons.Material.Outlined.SpaceDashboard, NavLinkMatch.All, "Alt+1"),
        new("Müşteriler", "/customers", Icons.Material.Outlined.People, NavLinkMatch.Prefix, "Alt+2"),
        new("İşlemler", "/transactions", Icons.Material.Outlined.ReceiptLong, NavLinkMatch.Prefix, "Alt+3"),
        // Barkodlu vitrin stoğu (Kasa ve Stok Raporları, Vitrin Stoku sayfasının üst düğmelerinde)
        new("Vitrin Stoku", "/stock", Icons.Material.Outlined.Inventory2, NavLinkMatch.All, "Alt+4"),
        new("Okut / Satış", "/stock/scan", Icons.Material.Outlined.QrCodeScanner, NavLinkMatch.Prefix, "Alt+5"),
        new("Ürün Girişi", "/stock/entry", Icons.Material.Outlined.AddBox, NavLinkMatch.Prefix, "Alt+6"),
        new("Sayım", "/stock/count", Icons.Material.Outlined.FactCheck, NavLinkMatch.Prefix, "Alt+7"),
    ];

    private static readonly NavEntry SettingsNavItem =
        new("Ayarlar", "/settings", Icons.Material.Outlined.Settings, NavLinkMatch.Prefix, "Alt+8");

    private RenderFragment NavItem(NavEntry item) =>
        @<MudTooltip Placement="Placement.Bottom" Delay="150">
            <ChildContent>
                <NavLink href="@item.Href" Match="@item.Match" class="kd-topnav-item" ActiveClass="active" aria-label="@item.Title">
                    <MudIcon Icon="@item.Icon" />
                </NavLink>
            </ChildContent>
            <TooltipContent>
                @item.Title <span class="kd-kbd">@item.Shortcut</span>
            </TooltipContent>
        </MudTooltip>;

    private bool isDarkMode;
    private string businessName = ProductInfo.Name;
    private LicenseState? licenseState;
    private MudAutocomplete<Customer>? searchAutocomplete;
    private DotNetObjectReference<ShortcutService>? shortcutRef;

    protected override async Task OnInitializedAsync()
    {
        AppState.LicenseChanged += OnLicenseChanged;

        var settings = await DatabaseService.GetSettingsAsync();
        if (!string.IsNullOrWhiteSpace(settings.BusinessName))
            businessName = settings.BusinessName;


        try
        {
            licenseState = await LicenseService.GetLicenseStateAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MainLayout lisans kontrolü hata: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            isDarkMode = await JS.InvokeAsync<string?>("kuyumcu.getPreference", "darkMode") == "1";
            shortcutRef = DotNetObjectReference.Create(Shortcuts);
            await JS.InvokeVoidAsync("kuyumcu.registerShortcuts", shortcutRef);
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("kuyumcu.setPreference", "darkMode", isDarkMode ? "1" : "0");
    }

    private async Task<IEnumerable<Customer>> SearchCustomers(string value, CancellationToken cancellationToken)
    {
        return await DatabaseService.GetCustomersPaginationAsync(0, 10, null, null, string.IsNullOrWhiteSpace(value) ? null : value);
    }

    private async Task OnCustomerSelected(Customer customer)
    {
        if (customer == null)
            return;

        NavigationManager.NavigateTo($"/customer/{customer.Id}");
        if (searchAutocomplete != null)
            await searchAutocomplete.ClearAsync();
    }

    private async Task NewCustomer()
    {
        var saved = await CustomerEditDialog.ShowAsync(DialogService);
        if (saved != null)
            NavigationManager.NavigateTo($"/customer/{saved.Id}");
    }

    // Lisans etkinleştirilince üst menüdeki deneme/lisans rozetini yenile
    private async void OnLicenseChanged()
    {
        try
        {
            licenseState = await LicenseService.GetLicenseStateAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MainLayout lisans yenileme hata: {ex.Message}");
        }
    }

    public void Dispose()
    {
        AppState.LicenseChanged -= OnLicenseChanged;
        shortcutRef?.Dispose();
    }
}
