@page "/customer/{CustomerId:int}"
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject DatabaseService DatabaseService
@inject NavigationManager NavigationManager
@inject IDialogService Dialog
@inject IReceiptPrinter PrintService
@inject CustomerSummaryImageService CustomerSummaryImageService
@inject ISnackbar Snackbar
@inject ShortcutService Shortcuts

<div class="kd-page">
    @if (isLoading && customer == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else if (customer == null)
    {
        <div class="kd-card">
            <EmptyState Icon="@Icons.Material.Outlined.PersonOff" Title="Müşteri bulunamadı" Text="Bu müşteri silinmiş olabilir.">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/customers">Müşterilere Dön</MudButton>
            </EmptyState>
        </div>
    }
    else
    {
        @* ---------- Müşteri başlık kartı ---------- *@
        <div class="kd-card kd-card-pad mb-4">
            <div class="d-flex flex-wrap align-center" style="gap:16px">
                <Avatar Name="@customer.Name" Large="true" />
                <div style="flex:1; min-width:220px">
                    <div class="d-flex align-center" style="gap:6px">
                        @* İsme tıklamak gizli işlemleri gösterir/gizler (bilerek göze batmayan bir kısayol) *@
                        <MudText Typo="Typo.h5" @onclick="ToggleHiddenTransactions" Style="cursor:default"
                                 Color="@(hasHiddenTransactions ? Color.Primary : Color.Default)">@customer.Name</MudText>
                        @if (showHiddenTransactions || !hasHiddenTransactions)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" Size="Size.Small" Title="Tüm işlemler görünüyor" Style="opacity:.55" />
                        }
                    </div>
                    <div class="kd-muted d-flex flex-wrap" style="gap:14px; font-size:.85rem; margin-top:2px">
                        @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
                        {
                            <span><MudIcon Icon="@Icons.Material.Outlined.Phone" Style="font-size:.95rem; vertical-align:-2px" /> <span class="kd-num">@customer.PhoneNumber.FormatPhoneNumber()</span></span>
                        }
                        <span><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Style="font-size:.95rem; vertical-align:-2px" /> @(allTransactions?.Count ?? 0) işlem</span>
                        @if (RecentTransactions.FirstOrDefault() is { } last)
                        {
                            <span><MudIcon Icon="@Icons.Material.Outlined.Schedule" Style="font-size:.95rem; vertical-align:-2px" /> Son işlem @last.Date.ToString("dd.MM.yyyy")</span>
                        }
                    </div>
                </div>

                <div class="d-flex align-center flex-wrap" style="gap:4px">
                    <MudTooltip Text="Önceki müşteri">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Variant="Variant.Outlined" Size="Size.Small"
                                       Disabled="@(previousCustomerId == null)" OnClick="GoToPreviousCustomer" />
                    </MudTooltip>
                    <MudTooltip Text="Sonraki müşteri">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Variant="Variant.Outlined" Size="Size.Small"
                                       Disabled="@(nextCustomerId == null)" OnClick="GoToNextCustomer" />
                    </MudTooltip>
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                    <MudTooltip Text="Özeti görsel olarak kopyala (WhatsApp'a yapıştırabilirsiniz)">
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopySummaryImage" Disabled="isCopyingSummary">
                            @(isCopyingSummary ? "Kopyalanıyor…" : "Özeti Kopyala")
                        </MudButton>
                    </MudTooltip>
                    @if (PrintService.IsSupported && availablePrinters.Any())
                    {
                        <MudMenu StartIcon="@Icons.Material.Outlined.Print" Label="Yazdır" Variant="Variant.Text" Dense="true"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            @foreach (var printer in availablePrinters)
                            {
                                <MudMenuItem OnClick="@(() => PrintCustomerReceipt(printer))"
                                             Icon="@(printer == selectedPrinter ? Icons.Material.Filled.Check : null)">@printer</MudMenuItem>
                            }
                        </MudMenu>
                    }
                    <MudTooltip Text="Müşteri bilgilerini düzenle">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="EditCustomer" />
                    </MudTooltip>
                </div>
            </div>

            <MudDivider Class="my-4" />

            <div class="d-flex flex-wrap" style="gap:10px">
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Large" StartIcon="@Icons.Material.Filled.NorthEast"
                           OnClick="@(() => ShowTransactionModal(TransactionType.CustomerDebt))">
                    Giden Ekle <span class="kd-kbd">F2</span>
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" StartIcon="@Icons.Material.Filled.SouthWest"
                           OnClick="@(() => ShowTransactionModal(TransactionType.StoreDebt))">
                    Gelen Ekle <span class="kd-kbd">F3</span>
                </MudButton>
            </div>
        </div>

        @* ---------- Güncel durum + son işlemler ---------- *@
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8">
                <MudText Typo="Typo.h6" Class="mb-3">Güncel Durum</MudText>
                @if (groupedTransactions == null || !groupedTransactions.Any())
                {
                    <div class="kd-card">
                        <EmptyState Icon="@Icons.Material.Outlined.Savings" Title="Henüz işlem yok"
                                    Text="Giden veya Gelen ekleyerek bu müşterinin hesabını başlatın." />
                    </div>
                }
                else
                {
                    <MudGrid Spacing="2">
                        @foreach (var group in groupedTransactions)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <div class="kd-card kd-balance-tile kd-clickable @(group.Balance > 0 ? "is-giden" : group.Balance < 0 ? "is-gelen" : "")"
                                     title="@($"{group.Key.GetDisplayName()} hareketlerine git")" @onclick="@(() => ScrollToCurrencyCard(group.Key))">
                                    <div class="kd-tile-label">@group.Key.GetDisplayName()</div>
                                    <div class="kd-tile-value"><BalanceAmount Balance="group.Balance" Currency="group.Key" ShowDirection="false" /></div>
                                    <div class="kd-tile-hint">@(group.Balance > 0 ? "Giden · müşteri borçlu" : group.Balance < 0 ? "Gelen · müşteri alacaklı" : "Hesap sıfır")</div>
                                </div>
                            </MudItem>
                        }
                        @if (depositTransactions != null && depositTransactions.Any())
                        {
                            @foreach (var group in depositTransactions.GroupBy(t => t.CurrencyType))
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <div class="kd-card kd-balance-tile is-emanet kd-clickable" title="Emanet işlemlerine git" @onclick="ScrollToDepositSection">
                                        <div class="kd-tile-label">@group.Key.GetDisplayName() · Emanet</div>
                                        <div class="kd-tile-value kd-num">@FormatHelper.FormatPrice(group.Sum(t => t.Amount)) @group.Key.GetSymbol()</div>
                                        <div class="kd-tile-hint">Müşterinin emaneti</div>
                                    </div>
                                </MudItem>
                            }
                        }
                    </MudGrid>
                }
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudText Typo="Typo.h6" Class="mb-3">Son İşlemler</MudText>
                <div class="kd-card">
                    @if (!RecentTransactions.Any())
                    {
                        <EmptyState Title="İşlem yok" />
                    }
                    else
                    {
                        @foreach (var recent in RecentTransactions)
                        {
                            <div class="kd-list-row" style="padding:9px 16px">
                                <TypeBadge Type="recent.Type" IsDeposit="recent.IsDeposit" />
                                <div style="flex:1; min-width:0">
                                    <div class="kd-num kd-strong">@FormatHelper.FormatPrice(recent.Amount) <span style="font-weight:500">@recent.CurrencyType.GetShortName()</span></div>
                                    <div class="kd-muted" style="font-size:.75rem">@recent.Date.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudItem>
        </MudGrid>

        @* ---------- Para birimi bazında hareketler ---------- *@
        @if (groupedTransactions != null && groupedTransactions.Any())
        {
            <div class="kd-section-title">
                <MudText Typo="Typo.h6">Hesap Hareketleri</MudText>
                <MudText Typo="Typo.caption" Class="kd-muted">Kalan: o işleme kadar biriken bakiye</MudText>
            </div>
            <MudGrid Spacing="3">
                @foreach (var currencyGroup in groupedTransactions)
                {
                    var allForCurrency = allTransactions
                        .Where(t => !t.IsDeposit && t.CurrencyType == currencyGroup.Key && (!t.IsHidden || showHiddenTransactions))
                        .Count();
                    var hasMoreTransactions = allForCurrency > currencyGroup.Transactions.Count;
                    var loadMoreId = $"load-more-{currencyGroup.Key}";

                    <MudItem xs="12" lg="6">
                        <div class="kd-card" id="@GetCurrencyCardId(currencyGroup.Key)">
                            <div class="kd-card-header">
                                <div>
                                    <MudText Typo="Typo.subtitle1">@currencyGroup.Key.GetDisplayName() <span class="kd-muted" style="font-weight:500">(@currencyGroup.Key.GetSymbol())</span></MudText>
                                    <div style="font-size:.85rem">Kalan: <BalanceAmount Balance="currencyGroup.Balance" Currency="currencyGroup.Key" Class="kd-strong" /></div>
                                </div>
                                <div class="d-flex" style="gap:6px">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="@(() => ShowTransactionModal(TransactionType.CustomerDebt, currencyGroup.Key))">Giden</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="@(() => ShowTransactionModal(TransactionType.StoreDebt, currencyGroup.Key))">Gelen</MudButton>
                                </div>
                            </div>

                            @if (hasMoreTransactions)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" id="@loadMoreId" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.ExpandLess"
                                           OnClick="@(() => LoadMoreTransactions(currencyGroup.Key, loadMoreId))">
                                    Daha eski işlemleri göster (@(allForCurrency - currencyGroup.Transactions.Count))
                                </MudButton>
                            }

                            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="kd-table">
                                <thead>
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Tür</th>
                                        <th class="kd-right">Tutar</th>
                                        <th class="kd-right">Kalan</th>
                                        <th style="width:96px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in currencyGroup.Transactions)
                                    {
                                        <tr style="@(t.IsHidden ? "opacity:.55" : "")">
                                            <td class="kd-num">
                                                @t.Date.ToString("dd.MM.yyyy")
                                                <span class="kd-muted" style="font-size:.75rem">@t.Date.ToString("HH:mm")</span>
                                            </td>
                                            <td><TypeBadge Type="t.Type" /></td>
                                            <td class="kd-right kd-num kd-strong">@FormatHelper.FormatPrice(t.Amount)</td>
                                            <td class="kd-right">
                                                @if (currencyGroup.RunningBalances.TryGetValue(t.Id, out var running))
                                                {
                                                    <BalanceAmount Balance="running" Currency="currencyGroup.Key" ShowDirection="false" ZeroText="0" />
                                                }
                                            </td>
                                            <td class="kd-right" style="white-space:nowrap">
                                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                                {
                                                    <MudTooltip Text="@t.Description">
                                                        <MudIconButton Icon="@Icons.Material.Outlined.Notes" Size="Size.Small" OnClick="@(() => ShowTransactionDescription(t))" />
                                                    </MudTooltip>
                                                }
                                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => EditTransaction(t))" aria-label="Düzenle" />
                                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteTransaction(t))" aria-label="Sil" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        }

        @* ---------- Emanetler ---------- *@
        @if (depositTransactions != null && depositTransactions.Any())
        {
            <div class="kd-section-title"><MudText Typo="Typo.h6">Emanetler</MudText></div>
            <div class="kd-card" id="@DEPOSIT_SECTION_ID">
                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="kd-table">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Cins</th>
                            <th class="kd-right">Miktar</th>
                            <th>Açıklama</th>
                            <th style="width:96px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in depositTransactions.OrderByDescending(x => x.Date))
                        {
                            <tr>
                                <td class="kd-num">@t.Date.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@t.CurrencyType.GetDisplayName()</td>
                                <td class="kd-right kd-num kd-strong">@FormatHelper.FormatPrice(t.Amount) @t.CurrencyType.GetSymbol()</td>
                                <td class="kd-muted">@t.Description</td>
                                <td class="kd-right" style="white-space:nowrap">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => EditTransaction(t))" aria-label="Düzenle" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteTransaction(t))" aria-label="Sil" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    }
</div>

@* ---------- İşlem ekleme / düzenleme penceresi ---------- *@
<MudDialog @bind-Visible="showTransactionModal" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(currentTransaction.Id == 0 ? "Yeni İşlem" : "İşlemi Düzenle") · @customer?.Name</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="currentTransaction" OnValidSubmit="SaveTransaction" id="transaction-form">
            <DataAnnotationsValidator />
            <MudStack Spacing="3" Class="pb-2">
                <div class="kd-type-toggle">
                    <div class="kd-type-option giden @(currentTransaction.Type == TransactionType.CustomerDebt ? "selected" : "")"
                         @onclick="@(() => SetTransactionType(TransactionType.CustomerDebt))">
                        <MudIcon Icon="@Icons.Material.Filled.NorthEast" Style="font-size:1rem; vertical-align:-3px" /> Giden
                        <div style="font-size:.72rem; font-weight:500">Müşteriye verildi</div>
                    </div>
                    <div class="kd-type-option gelen @(currentTransaction.Type == TransactionType.StoreDebt ? "selected" : "")"
                         @onclick="@(() => SetTransactionType(TransactionType.StoreDebt))">
                        <MudIcon Icon="@Icons.Material.Filled.SouthWest" Style="font-size:1rem; vertical-align:-3px" /> Gelen
                        <div style="font-size:.72rem; font-weight:500">Müşteriden alındı</div>
                    </div>
                </div>

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="7">
                        <MudTextField T="decimal" Label="Tutar" @bind-Value="currentTransaction.Amount" Class="kd-amount-input"
                                      Variant="Variant.Outlined" Required="true" RequiredError="Tutar gereklidir" Immediate="true"
                                      HelperText="@($"{FormatHelper.FormatPrice(currentTransaction.Amount)} {currentTransaction.CurrencyType.GetDisplayName()}")"
                                      For="@(() => currentTransaction.Amount)"
                                      UserAttributes="@(new Dictionary<string, object> { { "id", "amountInput" }, { "autocomplete", "off" } })" />
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudSelect T="CurrencyType" Label="Cins" @bind-Value="currentTransaction.CurrencyType" Variant="Variant.Outlined">
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.Gold24K">24 Ayar (gr)</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.Gold22K">22 Ayar (gr)</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.Gold14K">14 Ayar (gr)</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.QuarterGold">Çeyrek Altın</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.HalfGold">Yarım Altın</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.FullGold">Tam Altın</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.Ziynet">Ziynet Altın</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.TurkishLira">Türk Lirası</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.Dollar">Dolar</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.Euro">Euro</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.Sterlin">Sterlin</MudSelectItem>
                            <MudSelectItem T="CurrencyType" Value="CurrencyType.Riyal">Riyal</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="7">
                        <MudDatePicker Label="Tarih" @bind-Date="currentTransactionDate" PickerVariant="PickerVariant.Dialog" Editable="true"
                                       Mask="@(new DateMask("dd.MM.yyyy"))" DateFormat="dd.MM.yyyy" Placeholder="gg.aa.yyyy" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="5">
                        <MudTimePicker Label="Saat" @bind-Time="currentTransactionTime" PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined" Editable="true" />
                    </MudItem>
                </MudGrid>

                <MudTextField T="string" Label="Açıklama (isteğe bağlı)" @bind-Value="currentTransaction.Description"
                              Variant="Variant.Outlined" Lines="2" />

                <div class="d-flex flex-wrap" style="gap:16px">
                    @if (currentTransaction.Type == TransactionType.StoreDebt)
                    {
                        <MudSwitch @bind-Value="currentTransaction.IsDeposit" Label="Emanet olarak kaydet" Color="Color.Primary" />
                    }
                    <MudSwitch @bind-Value="currentTransaction.IsHidden" Label="Gizli" Color="Color.Default" />
                </div>
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseTransactionModal">İptal</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="transaction-form" Variant="Variant.Filled"
                   Color="@(currentTransaction.Type == TransactionType.CustomerDebt ? Color.Error : Color.Success)">
            @(currentTransaction.Type == TransactionType.CustomerDebt ? "Gideni Kaydet" : "Geleni Kaydet")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int CustomerId { get; set; }

    // Para birimi başına yüklenen işlem sayısı ("Daha eski işlemleri göster" ile artar)
    private Dictionary<CurrencyType, int> loadedTransactionsCount = new();
    private const int PAGE_SIZE = 5;
    private const int RECENT_TRANSACTIONS_COUNT = 6;
    private const string DEPOSIT_SECTION_ID = "deposit-transactions-section";

    /// <summary>Son işlemler (emanetler dahil, gizliler görünürlük ayarına göre).</summary>
    private IEnumerable<Transaction> RecentTransactions =>
        (allTransactions ?? new List<Transaction>())
            .Where(t => showHiddenTransactions || !t.IsHidden)
            .OrderByDescending(t => t.Date)
            .ThenByDescending(t => t.Id)
            .Take(RECENT_TRANSACTIONS_COUNT);

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private Customer? customer;
    private List<Transaction> transactions = new();
    private List<Transaction> allTransactions = new(); // gizliler dahil
    private List<Transaction> depositTransactions = new();
    private List<TransactionGroup> groupedTransactions = new();
    private bool isLoading = true;

    private bool showHiddenTransactions;
    private bool hasHiddenTransactions;

    private bool showTransactionModal;
    private Transaction currentTransaction = new();
    private DateTime? currentTransactionDate;
    private TimeSpan? currentTransactionTime;

    private bool isCopyingSummary;
    private bool focusAmountInput;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Pencere açıldıktan sonra tutar alanına odaklan ve içeriğini seç (hızlı giriş için)
        if (focusAmountInput && showTransactionModal)
        {
            focusAmountInput = false;
            await JSRuntime.InvokeVoidAsync("kuyumcu.focusAndSelect", "amountInput");
        }
    }

    private List<string> availablePrinters = new();
    private string? selectedPrinter;
    private int? nextCustomerId;
    private int? previousCustomerId;
    private int loadedCustomerId;

    protected override void OnInitialized()
    {
        LoadPrinters();
        Shortcuts.Handler = OnShortcut;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CustomerId != loadedCustomerId)
        {
            // Önceki/sonraki müşteriye geçişte görünürlük ayarı sıfırlanır
            showHiddenTransactions = false;
            loadedCustomerId = CustomerId;
        }
        await LoadCustomerData();
    }

    private async Task OnShortcut(string key)
    {
        if (customer == null || showTransactionModal)
            return;

        await InvokeAsync(() =>
        {
            if (key == "F2") ShowTransactionModal(TransactionType.CustomerDebt);
            else if (key == "F3") ShowTransactionModal(TransactionType.StoreDebt);
            StateHasChanged();
        });
    }

    private void LoadPrinters()
    {
        if (!PrintService.IsSupported)
            return;

        try
        {
            availablePrinters = PrintService.GetAvailablePrinters();
            // Termal yazıcı varsa onu, yoksa ilk yazıcıyı varsayılan yap
            selectedPrinter = availablePrinters.FirstOrDefault(p => p.Contains("thermal", StringComparison.OrdinalIgnoreCase) || p.Contains("termal", StringComparison.OrdinalIgnoreCase))
                              ?? availablePrinters.FirstOrDefault();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Yazıcı listesi alınamadı: {ex.Message}");
        }
    }

    private async Task LoadCustomerData()
    {
        isLoading = true;

        customer = await DatabaseService.GetCustomerAsync(CustomerId);
        if (customer != null)
        {
            loadedTransactionsCount = new Dictionary<CurrencyType, int>();
            allTransactions = await DatabaseService.GetCustomerTransactionsAsync(CustomerId) ?? new List<Transaction>();

            // Emanetler ayrı gösterilir
            depositTransactions = allTransactions.Where(t => t.IsDeposit).ToList();
            transactions = allTransactions.Where(t => !t.IsDeposit).ToList();

            await GroupTransactions();

            previousCustomerId = await DatabaseService.GetPreviousCustomerIdAsync(CustomerId);
            nextCustomerId = await DatabaseService.GetNextCustomerIdAsync(CustomerId);
        }

        isLoading = false;
    }

    private async Task GroupTransactions()
    {
        hasHiddenTransactions = transactions.Any(t => t.IsHidden);

        if (transactions.Count == 0)
        {
            groupedTransactions = new List<TransactionGroup>();
            return;
        }

        var filteredTransactions = showHiddenTransactions ? transactions : transactions.Where(t => !t.IsHidden).ToList();
        var currencyTypes = filteredTransactions.Select(t => t.CurrencyType).Distinct().ToList();

        foreach (var currencyType in currencyTypes)
        {
            if (!loadedTransactionsCount.ContainsKey(currencyType))
                loadedTransactionsCount[currencyType] = PAGE_SIZE;
        }

        var groups = new List<TransactionGroup>();
        foreach (var currencyType in currencyTypes)
        {
            // Bu para biriminin en yeni N işlemi
            var page = await DatabaseService.GetCustomerTransactionsByCurrencyPaginatedAsync(
                CustomerId, currencyType, 0, loadedTransactionsCount[currencyType]);
            if (!showHiddenTransactions)
                page = page.Where(t => !t.IsHidden).ToList();

            // Toplam bakiye sayfalamadan bağımsız hesaplanır
            var allForCurrency = filteredTransactions.Where(t => t.CurrencyType == currencyType).ToList();
            var balance = allForCurrency.Where(t => t.Type == TransactionType.CustomerDebt).Sum(t => t.Amount) -
                          allForCurrency.Where(t => t.Type == TransactionType.StoreDebt).Sum(t => t.Amount);

            // Kümülatif kalan tüm geçmiş üzerinden kronolojik sırayla hesaplanır;
            // böylece ekranda kaç işlem yüklenmiş olursa olsun her satırdaki kalan doğrudur.
            var runningBalances = new Dictionary<int, decimal>();
            decimal running = 0m;
            foreach (var t in allForCurrency.OrderBy(x => x.Date).ThenBy(x => x.Id))
            {
                running += t.Type == TransactionType.CustomerDebt ? t.Amount : -t.Amount;
                runningBalances[t.Id] = running;
            }

            groups.Add(new TransactionGroup
            {
                Key = currencyType,
                Transactions = page.OrderBy(x => x.Date).ThenBy(x => x.Id).ToList(),
                Balance = balance,
                RunningBalances = runningBalances
            });
        }

        groupedTransactions = groups.OrderBy(g => g.Key.ToString()).ToList();
    }

