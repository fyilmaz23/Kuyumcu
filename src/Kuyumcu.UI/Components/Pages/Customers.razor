@page "/customers"
@inject DatabaseService DatabaseService
@inject NavigationManager NavigationManager
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<div class="kd-page">
    <PageHeader Title="Müşteriler" Subtitle="@($"{totalCount:N0} müşteri")" />

    <div class="kd-card">
        <div class="kd-card-header">
            <div style="width: min(420px, 100%)">
                <MudTextField T="string" Placeholder="İsim veya telefon ile ara…" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Value="searchTerm" ValueChanged="OnSearch" Immediate="true" DebounceInterval="250" Clearable="true" />
            </div>
            <MudText Typo="Typo.caption" Class="kd-muted">Satıra tıklayarak müşterinin hesabını açın.</MudText>
        </div>

        <MudTable T="Customer" ServerData="ServerReload" @ref="table" Class="kd-table" Elevation="0"
                  Hover="true" Breakpoint="Breakpoint.Sm" OnRowClick="RowClickEvent" RowClass="kd-row-link"
                  LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="name" T="Customer" InitialDirection="MudBlazor.SortDirection.Ascending">Müşteri</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="phone" T="Customer">Telefon</MudTableSortLabel></MudTh>
                <MudTh>Açık bakiyeler</MudTh>
                <MudTh Style="width:96px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Müşteri">
                    <div class="d-flex align-center gap-3">
                        <Avatar Name="@context.Name" />
                        <span class="kd-strong">@context.Name</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Telefon"><span class="kd-num kd-muted">@context.PhoneNumber.FormatPhoneNumber()</span></MudTd>
                <MudTd DataLabel="Açık bakiyeler">
                    @if (balances.TryGetValue(context.Id, out var list) && list.Count > 0)
                    {
                        <div class="d-flex flex-wrap" style="gap:6px">
                            @foreach (var b in list.Take(4))
                            {
                                <span class="kd-badge @(b.NetBalance > 0 ? "giden" : "gelen")" title="@(b.NetBalance > 0 ? "Giden" : "Gelen")">
                                    <span class="kd-num">@FormatHelper.FormatPrice(Math.Abs(b.NetBalance)) @b.CurrencyType.GetShortName()</span>
                                </span>
                            }
                            @if (list.Count > 4)
                            {
                                <span class="kd-badge notr">+@(list.Count - 4)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="kd-muted" style="font-size:.8rem">Hesap sıfır</span>
                    }
                </MudTd>
                <MudTd Style="text-align:right">
                    <div @onclick:stopPropagation="true" style="display:inline-flex">
                    <MudTooltip Text="Düzenle">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       OnClick="@(() => ShowCustomerModal(context))" />
                    </MudTooltip>
                    <MudTooltip Text="Sil">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteCustomer(context))" />
                    </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (string.IsNullOrWhiteSpace(searchTerm))
                {
                    <EmptyState Icon="@Icons.Material.Outlined.PersonAddAlt" Title="Henüz müşteri yok" Text="İlk müşterinizi ekleyerek başlayın.">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ShowCustomerModal(new Customer()))">Yeni Müşteri</MudButton>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="Sonuç bulunamadı" Text="@($"\"{searchTerm}\" ile eşleşen müşteri yok.")" />
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Sayfa başına:" InfoFormat="{first_item}-{last_item} / {all_items}" PageSizeOptions="new[] { 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </div>
</div>



@code {
    private MudTable<Customer>? table;
    private string searchTerm = string.Empty;
    private int totalCount;
    private Dictionary<int, List<CustomerCurrencyBalance>> balances = new();

    protected override async Task OnInitializedAsync()
    {
        totalCount = await DatabaseService.GetCustomerCountAsync(string.Empty);
        var summary = await DatabaseService.GetCurrencyBalanceSummaryAsync();
        balances = summary.CustomerBalances
            .GroupBy(b => b.CustomerId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(b => Math.Abs(b.NetBalance)).ToList());
    }

    private async Task<TableData<Customer>> ServerReload(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var items = await DatabaseService.GetCustomersPaginationAsync(state.Page, state.PageSize, state.SortLabel,
                Helper.HelperMethods.GetSortDirection(state.SortDirection), searchTerm);
            var total = await DatabaseService.GetCustomerCountAsync(searchTerm);
            return new TableData<Customer> { Items = items, TotalItems = total };
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            return new TableData<Customer> { Items = new List<Customer>(), TotalItems = 0 };
        }
    }

    private async Task OnSearch(string text)
    {
        searchTerm = text ?? string.Empty;
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task ShowCustomerModal(Customer customer)
    {
        var isNew = customer.Id == 0;
        var saved = await CustomerEditDialog.ShowAsync(Dialog, customer);
        if (saved == null)
            return;

        if (isNew || saved.Id != customer.Id)
        {
            NavigationManager.NavigateTo($"/customer/{saved.Id}");
            return;
        }

        Snackbar.Add("Müşteri bilgileri güncellendi.", Severity.Success);
        if (table != null)
            await table.ReloadServerData();
    }

    private async Task DeleteCustomer(Customer customer)
    {
        var confirm = await Dialog.ShowMessageBox(
            "Müşteriyi sil",
            $"{customer.Name} silinecek. Devam edilsin mi?",
            yesText: "Sil",
            cancelText: "Vazgeç");

        if (confirm == true)
        {
            await DatabaseService.DeleteCustomerAsync(customer);
            totalCount = await DatabaseService.GetCustomerCountAsync(string.Empty);
            Snackbar.Add($"{customer.Name} silindi.", Severity.Info);
            if (table != null)
                await table.ReloadServerData();
        }
    }

    private void RowClickEvent(TableRowClickEventArgs<Customer> args)
    {
        if (args?.Item != null)
            NavigationManager.NavigateTo($"/customer/{args.Item.Id}");
    }
}
