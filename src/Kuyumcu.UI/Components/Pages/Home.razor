@page "/"
@page "/home"
@inject DatabaseService DatabaseService
@inject NavigationManager NavigationManager
@inject GoldPriceExportService GoldPrices
@inject CustomerBrowseContext Browse
@inject IDialogService DialogService

<div class="kd-page">
    <PageHeader Title="@greeting" Subtitle="@DateTime.Now.ToString("dd MMMM yyyy, dddd")">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ReceiptLong" Href="/transactions">
                Tüm İşlemler
            </MudButton>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        @* ---------- Kısa göstergeler: tıklayınca ilgili süzgeçle müşteri listesi ---------- *@
        <div class="kd-kpis">
            <button type="button" class="kd-kpi" @onclick="@(() => OpenCustomers(new CustomerListFilter()))">
                <span class="kd-kpi-label">Müşteri</span>
                <span class="kd-kpi-value">@rows.Count.ToString("N0")</span>
                <span class="kd-kpi-hint">@activeThisMonth aktif (bu ay)</span>
            </button>
            <button type="button" class="kd-kpi is-giden" @onclick="@(() => OpenCustomers(new CustomerListFilter { Balance = BalanceFilter.Giden }))">
                <span class="kd-kpi-label">Borçlu müşteri</span>
                <span class="kd-kpi-value">@debtorCount.ToString("N0")</span>
                <span class="kd-kpi-hint">Giden bakiyesi olan</span>
            </button>
            <button type="button" class="kd-kpi is-gelen" @onclick="@(() => OpenCustomers(new CustomerListFilter { Balance = BalanceFilter.Gelen }))">
                <span class="kd-kpi-label">Alacaklı müşteri</span>
                <span class="kd-kpi-value">@creditorCount.ToString("N0")</span>
                <span class="kd-kpi-hint">Gelen bakiyesi olan</span>
            </button>
            <button type="button" class="kd-kpi is-emanet" @onclick="@(() => OpenCustomers(new CustomerListFilter { HasDeposit = true }))">
                <span class="kd-kpi-label">Emanet</span>
                <span class="kd-kpi-value">@depositCustomerCount.ToString("N0")</span>
                <span class="kd-kpi-hint">müşteride emanet var</span>
            </button>
            <button type="button" class="kd-kpi is-warning" @onclick="@(() => OpenCustomers(new CustomerListFilter { Balance = BalanceFilter.Giden, InactiveDays = FollowUpDays, Sort = CustomerSort.LastTransaction }))">
                <span class="kd-kpi-label">Takip edilecek</span>
                <span class="kd-kpi-value">@followUp.Count.ToString("N0")</span>
                <span class="kd-kpi-hint">@FollowUpDays+ gündür uğramayan borçlu</span>
            </button>
            <a class="kd-kpi" href="/transactions">
                <span class="kd-kpi-label">Bugün</span>
                <span class="kd-kpi-value">@today.Count.ToString("N0") <small>işlem</small></span>
                <span class="kd-kpi-hint">@monthCount.ToString("N0") işlem bu ay</span>
            </a>
        </div>

        <div class="kd-dash">
            @* ---------- Bakiyeler: tablo + seçilen tutarın müşterileri ---------- *@
            <section class="kd-card kd-dash-wide">
                <div class="kd-card-header">
                    <div>
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.Savings" /> Bakiyeler</div>
                        <div class="kd-muted" style="font-size:.78rem">Cins başına açık bakiyeler. Tutara tıklayınca o bakiyedeki müşteriler yanda listelenir.</div>
                    </div>
                </div>

                @if (balanceRows.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.Savings" Title="Açık bakiye yok" Text="Tüm müşteri hesapları sıfır." />
                }
                else
                {
                    <div class="kd-balances">
                        <table class="kd-grid-table kd-balance-table">
                            <thead>
                                <tr>
                                    <th>Cins</th>
                                    <th class="kd-right">Giden <span class="kd-th-hint">müşteri borçlu</span></th>
                                    <th class="kd-right">Gelen <span class="kd-th-hint">müşteri alacaklı</span></th>
                                    <th class="kd-right">Fark</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in balanceRows)
                                {
                                    <tr>
                                        <td class="kd-strong">@row.Currency.GetDisplayName()</td>
                                        <td class="kd-right kd-cell-pick @(IsSelected(row.Currency, true) ? "is-on" : null) @(row.GidenCount == 0 ? "is-empty" : null)"
                                            @onclick="@(() => Select(row.Currency, true))">
                                            @if (row.GidenCount > 0)
                                            {
                                                <span class="kd-num kd-giden kd-strong">@FormatHelper.FormatPrice(row.Giden) @row.Currency.GetSymbol()</span>
                                                <span class="kd-cell-count">@row.GidenCount</span>
                                            }
                                            else
                                            {
                                                <span class="kd-muted">—</span>
                                            }
                                        </td>
                                        <td class="kd-right kd-cell-pick @(IsSelected(row.Currency, false) ? "is-on" : null) @(row.GelenCount == 0 ? "is-empty" : null)"
                                            @onclick="@(() => Select(row.Currency, false))">
                                            @if (row.GelenCount > 0)
                                            {
                                                <span class="kd-num kd-gelen kd-strong">@FormatHelper.FormatPrice(row.Gelen) @row.Currency.GetSymbol()</span>
                                                <span class="kd-cell-count">@row.GelenCount</span>
                                            }
                                            else
                                            {
                                                <span class="kd-muted">—</span>
                                            }
                                        </td>
                                        <td class="kd-right">
                                            <BalanceAmount Balance="@(row.Giden - row.Gelen)" Currency="row.Currency" ZeroText="Dengede" ShowDirection="false" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="kd-balance-detail">
                            @if (selected is { } sel)
                            {
                                var list = SelectedList;
                                var pageCount = Math.Max(1, (list.Count + DetailPageSize - 1) / DetailPageSize);
                                <div class="kd-balance-detail-head">
                                    <div style="min-width:0">
                                        <div class="kd-strong">
                                            @sel.Currency.GetDisplayName() ·
                                            <span class="@(sel.Giden ? "kd-giden" : "kd-gelen")">@(sel.Giden ? "Giden" : "Gelen")</span>
                                        </div>
                                        <div class="kd-muted" style="font-size:.78rem">
                                            @list.Count müşteri · toplam
                                            <span class="kd-num">@FormatHelper.FormatPrice(list.Sum(x => Math.Abs(x.Net))) @sel.Currency.GetSymbol()</span>
                                        </div>
                                    </div>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward"
                                               OnClick="OpenSelectionInCustomers">Listede aç</MudButton>
                                </div>
                                <div class="kd-balance-detail-list">
                                    @foreach (var item in list.Skip(detailPage * DetailPageSize).Take(DetailPageSize))
                                    {
                                        <div class="kd-list-row kd-clickable" @onclick="@(() => OpenFromSelection(item.Row.Customer.Id))">
                                            <Avatar Name="@item.Row.Customer.Name" />
                                            <div style="flex:1; min-width:0">
                                                <div class="kd-ellipsis">@item.Row.Customer.Name</div>
                                                <div class="kd-muted" style="font-size:.72rem">@LastText(item.Row.LastTransaction)</div>
                                            </div>
                                            <span class="kd-num kd-strong @(sel.Giden ? "kd-giden" : "kd-gelen")">@FormatHelper.FormatPrice(Math.Abs(item.Net)) @sel.Currency.GetSymbol()</span>
                                        </div>
                                    }
                                </div>
                                @if (pageCount > 1)
                                {
                                    <div class="kd-balance-detail-pager">
                                        <MudPagination Count="pageCount" Selected="detailPage + 1" SelectedChanged="@(p => detailPage = p - 1)" Size="Size.Small"
                                                       BoundaryCount="1" MiddleCount="1" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </section>

            @* ---------- Hızlı işlem + bugün ---------- *@
            <div class="kd-dash-side">
                <section class="kd-card kd-card-pad">
                    <div class="kd-card-title mb-3"><MudIcon Icon="@Icons.Material.Outlined.Bolt" /> Hızlı İşlem</div>
                    <MudAutocomplete T="Customer" @bind-Value="quickCustomer" Placeholder="Müşteri seçin…" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Dense="true" SearchFunc="SearchCustomers" ToStringFunc="@(c => c?.Name)" Clearable="true" MaxItems="8"
                                     MinCharacters="1" AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start" ShowProgressIndicator="false" />
                    <div class="kd-quick-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.NorthEast" Disabled="@(quickCustomer == null)"
                                   OnClick="@(() => Quick("giden"))">Giden</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.SouthWest" Disabled="@(quickCustomer == null)"
                                   OnClick="@(() => Quick("gelen"))">Gelen</MudButton>
                        <MudTooltip Text="Müşterinin hesabını aç">
                            <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Variant="Variant.Outlined" Disabled="@(quickCustomer == null)"
                                           OnClick="@(() => Quick(null))" aria-label="Hesabı aç" />
                        </MudTooltip>
                    </div>
                </section>

                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.Today" /> Bugün</div>
                        <span class="kd-muted" style="font-size:.78rem">@today.Count işlem</span>
                    </div>
                    @if (todayRows.Count == 0)
                    {
                        <div class="kd-muted pa-4" style="font-size:.85rem">Bugün henüz işlem yok.</div>
                    }
                    else
                    {
                        <table class="kd-grid-table kd-compact">
                            <thead><tr><th>Cins</th><th class="kd-right">Giden</th><th class="kd-right">Gelen</th></tr></thead>
                            <tbody>
                                @foreach (var r in todayRows)
                                {
                                    <tr>
                                        <td>@r.Currency.GetDisplayName()@(r.Deposit ? " · emanet" : "")</td>
                                        <td class="kd-right kd-num @(r.Deposit ? "" : "kd-giden")">@(r.Giden > 0 ? $"{FormatHelper.FormatPrice(r.Giden)} {r.Currency.GetSymbol()}" : "—")</td>
                                        <td class="kd-right kd-num @(r.Deposit ? "" : "kd-gelen")">@(r.Gelen > 0 ? $"{FormatHelper.FormatPrice(r.Gelen)} {r.Currency.GetSymbol()}" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            </div>

            @* ---------- İşlemler (süzgeçli küçük liste; tam hâli İşlemler sayfasında) ---------- *@
            <div class="kd-dash-wide">
                <TransactionFeed Compact="true" PageSize="8" Title="İşlemler" />
            </div>

            @* ---------- Fiyatlar + takip ---------- *@
            <div class="kd-dash-side">
                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.ShowChart" /> Altın Fiyatları</div>
                        <div class="d-flex align-center">
                            <MudTooltip Text="Fiyat görselini paylaş (şablonlu)">
                                <MudIconButton Icon="@Icons.Material.Outlined.Share" Size="Size.Small" Disabled="@(pricesLoading || prices is not { Count: > 0 })"
                                               OnClick="@(() => GoldPriceShareDialog.ShowAsync(DialogService, prices))" aria-label="Fiyat görselini paylaş" />
                            </MudTooltip>
                            <MudTooltip Text="@($"Yenile · {GoldPrices.SourceName}")">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="@(() => LoadPrices(true))" Disabled="pricesLoading" aria-label="Fiyatları yenile" />
                            </MudTooltip>
                        </div>
                    </div>
                    @if (pricesLoading && prices == null)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (prices is not { Count: > 0 })
                    {
                        <div class="kd-muted pa-4" style="font-size:.85rem">Fiyatlar alınamadı (internet bağlantısını kontrol edin).</div>
                    }
                    else
                    {
                        <table class="kd-grid-table kd-compact">
                            <thead><tr><th></th><th class="kd-right">Alış</th><th class="kd-right">Satış</th></tr></thead>
                            <tbody>
                                @foreach (var p in prices.Take(8))
                                {
                                    <tr>
                                        <td>@p.Type</td>
                                        <td class="kd-right kd-num">@(p.BuyPrice == p.SellPrice ? "—" : FormatHelper.FormatPrice(p.BuyPrice))</td>
                                        <td class="kd-right kd-num kd-strong">@FormatHelper.FormatPrice(p.SellPrice)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="kd-muted" style="font-size:.72rem; padding:6px 16px 10px">@prices[0].UpdateTime.ToString("HH:mm") · @GoldPrices.SourceName</div>
                    }
                </section>

                <section class="kd-card">
                    <div class="kd-card-header">
                        <div>
                            <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.NotificationsActive" /> Takip Edilecekler</div>
                            <div class="kd-muted" style="font-size:.75rem">Borcu olup @FollowUpDays+ gündür işlem yapmayanlar</div>
                        </div>
                    </div>
                    @if (followUp.Count == 0)
                    {
                        <div class="kd-muted pa-4" style="font-size:.85rem">Takip edilecek müşteri yok.</div>
                    }
                    else
                    {
                        @foreach (var r in followUp.Take(5))
                        {
                            <div class="kd-list-row kd-clickable" @onclick="@(() => NavigationManager.NavigateTo($"/customer/{r.Customer.Id}"))">
                                <div style="flex:1; min-width:0">
                                    <div class="kd-ellipsis">@r.Customer.Name</div>
                                    <div class="kd-muted" style="font-size:.72rem">@LastText(r.LastTransaction)</div>
                                </div>
                                <div class="kd-badges" style="justify-content:flex-end">
                                    @foreach (var b in r.Balances.Where(b => b.Net > 0).Take(2))
                                    {
                                        <span class="kd-badge giden"><span class="kd-num">@FormatHelper.FormatPrice(b.Net) @b.Currency.GetShortName()</span></span>
                                    }
                                </div>
                            </div>
                        }
                        @if (followUp.Count > 5)
                        {
                            <div class="pa-2">
                                <MudButton Size="Size.Small" Variant="Variant.Text" FullWidth="true"
                                           OnClick="@(() => OpenCustomers(new CustomerListFilter { Balance = BalanceFilter.Giden, InactiveDays = FollowUpDays, Sort = CustomerSort.LastTransaction }))">
                                    Tümünü gör (@followUp.Count)
                                </MudButton>
                            </div>
                        }
                    }
                </section>
            </div>
        </div>
    }
</div>

@code {
    private const int FollowUpDays = 60;
    private const int DetailPageSize = 8;

    private bool isLoading = true;
    private string greeting = "Hoş geldiniz";

    private List<CustomerRow> rows = new();
    private Dictionary<int, string> customerNames = new();
    private int debtorCount, creditorCount, depositCustomerCount, activeThisMonth, monthCount;
    private List<CustomerRow> followUp = new();
    private List<Transaction> today = new();
    private List<TodayRow> todayRows = new();
    private List<BalanceRow> balanceRows = new();

    private (CurrencyType Currency, bool Giden)? selected;
    private int detailPage;

    private Customer? quickCustomer;

    private List<GoldPriceDto>? prices;
    private bool pricesLoading;

    private sealed record BalanceRow(CurrencyType Currency, decimal Giden, int GidenCount, decimal Gelen, int GelenCount);
    private sealed record TodayRow(CurrencyType Currency, bool Deposit, decimal Giden, decimal Gelen);

    protected override async Task OnInitializedAsync()
    {
        var settings = await DatabaseService.GetSettingsAsync();
        var hour = DateTime.Now.Hour;
        var salute = hour < 12 ? "Günaydın" : hour < 18 ? "İyi günler" : "İyi akşamlar";
        greeting = string.IsNullOrWhiteSpace(settings.BusinessName) ? salute : $"{salute}, {settings.BusinessName}";

        try
        {
            var customers = await DatabaseService.GetCustomersAsync();
            var transactions = await DatabaseService.GetTransactionsAsync();
            Build(customers, transactions);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ana sayfa verisi yüklenirken hata: {ex.Message}");
        }
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Fiyatlar sayfayı bekletmesin: ilk çizimden sonra arka planda
        if (firstRender)
            await LoadPrices(false);
    }

    private async Task LoadPrices(bool force)
    {
        pricesLoading = true;
        StateHasChanged();
        try { prices = await GoldPrices.GetGoldPricesAsync(force); }
        catch (Exception ex) { Console.WriteLine($"Fiyatlar alınamadı: {ex.Message}"); }
        pricesLoading = false;
        StateHasChanged();
    }

    private void Build(List<Customer> customers, List<Transaction> transactions)
    {
        var now = DateTime.Now;
        customerNames = customers.ToDictionary(c => c.Id, c => c.Name);
        var live = transactions.Where(t => !t.IsDeleted && customerNames.ContainsKey(t.CustomerId)).ToList();
        rows = CustomerDirectory.BuildRows(customers, live);

        debtorCount = rows.Count(r => r.Balances.Any(b => b.Net > 0));
        creditorCount = rows.Count(r => r.Balances.Any(b => b.Net < 0));
        depositCustomerCount = rows.Count(r => r.Deposits.Any(d => d.Net > 0));
        followUp = CustomerDirectory.Apply(rows,
            new CustomerListFilter { Balance = BalanceFilter.Giden, InactiveDays = FollowUpDays, Sort = CustomerSort.LastTransaction }, now);
        followUp.Reverse(); // en uzun süredir uğramayan önce

        var monthStart = new DateTime(now.Year, now.Month, 1);
        monthCount = live.Count(t => t.Date >= monthStart);
        activeThisMonth = live.Where(t => t.Date >= monthStart).Select(t => t.CustomerId).Distinct().Count();

        today = live.Where(t => t.Date.Date == now.Date && !t.IsHidden).ToList();
        todayRows = today.GroupBy(t => (t.CurrencyType, t.IsDeposit))
            .OrderBy(g => g.Key.IsDeposit).ThenBy(g => g.Key.CurrencyType)
            .Select(g => new TodayRow(g.Key.CurrencyType, g.Key.IsDeposit,
                g.Where(t => t.Type == TransactionType.CustomerDebt).Sum(t => t.Amount),
                g.Where(t => t.Type == TransactionType.StoreDebt).Sum(t => t.Amount)))
            .ToList();

        balanceRows = rows.SelectMany(r => r.Balances)
            .GroupBy(b => b.Currency)
            .Select(g => new BalanceRow(g.Key,
                g.Where(b => b.Net > 0).Sum(b => b.Net), g.Count(b => b.Net > 0),
                -g.Where(b => b.Net < 0).Sum(b => b.Net), g.Count(b => b.Net < 0)))
            .OrderBy(r => CurrencyOrder(r.Currency))
            .ToList();

        // Başlangıçta en çok müşterisi olan Giden hücresi seçili gelir (boş panel kalmasın)
        var first = balanceRows.OrderByDescending(r => r.GidenCount).FirstOrDefault();
        if (first != null)
            selected = (first.Currency, first.GidenCount > 0);
    }

    private static int CurrencyOrder(CurrencyType c) => c switch
    {
        CurrencyType.TurkishLira => 0, CurrencyType.Gold24K => 1, CurrencyType.Gold22K => 2, CurrencyType.Gold14K => 3,
        CurrencyType.QuarterGold => 4, CurrencyType.HalfGold => 5, CurrencyType.FullGold => 6, CurrencyType.Ziynet => 7,
        CurrencyType.Dollar => 8, CurrencyType.Euro => 9, CurrencyType.Sterlin => 10, _ => 11,
    };

    private bool IsSelected(CurrencyType c, bool giden) => selected is { } s && s.Currency == c && s.Giden == giden;

    private void Select(CurrencyType c, bool giden)
    {
        var row = balanceRows.FirstOrDefault(r => r.Currency == c);
        if (row == null || (giden ? row.GidenCount : row.GelenCount) == 0)
            return;
        selected = (c, giden);
        detailPage = 0;
    }

    private List<(CustomerRow Row, decimal Net)> SelectedList
    {
        get
        {
            if (selected is not { } s)
                return new();
            return rows.Select(r => (Row: r, Net: r.BalanceOf(s.Currency)))
                .Where(x => s.Giden ? x.Net > 0 : x.Net < 0)
                .OrderByDescending(x => Math.Abs(x.Net))
                .ToList();
        }
    }

    private CustomerListFilter SelectionFilter() => selected is { } s
        ? new CustomerListFilter { Currencies = { s.Currency }, Balance = s.Giden ? BalanceFilter.Giden : BalanceFilter.Gelen, Sort = CustomerSort.Balance }
        : new CustomerListFilter();

    private void OpenSelectionInCustomers() => OpenCustomers(SelectionFilter());

    private void OpenFromSelection(int customerId)
    {
        // Önceki/sonraki bu listede gezsin (ör. "Euro · Giden")
        var filter = SelectionFilter();
        Browse.SetList(SelectedList.Select(x => x.Row.Customer.Id).ToList(), filter.Describe());
        NavigationManager.NavigateTo($"/customer/{customerId}");
    }

    private void OpenCustomers(CustomerListFilter filter)
    {
        Browse.Filter = filter;
        Browse.Page = 0;
        NavigationManager.NavigateTo("/customers");
    }

    private async Task<IEnumerable<Customer>> SearchCustomers(string value, CancellationToken cancellationToken) =>
        await DatabaseService.GetCustomersPaginationAsync(0, 8, null, null, string.IsNullOrWhiteSpace(value) ? null : value);

    private void Quick(string? action)
    {
        if (quickCustomer == null)
            return;
        NavigationManager.NavigateTo(action == null ? $"/customer/{quickCustomer.Id}" : $"/customer/{quickCustomer.Id}?islem={action}");
    }

    private static string LastText(DateTime? date)
    {
        if (date is not { } d)
            return "İşlem yok";
        var days = (DateTime.Today - d.Date).Days;
        return days switch
        {
            <= 0 => "Son işlem bugün",
            1 => "Son işlem dün",
            < 60 => $"Son işlem {days} gün önce",
            _ => $"Son işlem {d:dd.MM.yyyy}",
        };
    }

}
