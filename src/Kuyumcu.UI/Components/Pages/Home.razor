@page "/"
@page "/home"
@using Kuyumcu.Helpers
@inject DatabaseService DatabaseService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="kd-page">
    <PageHeader Title="@greeting" Subtitle="@DateTime.Now.ToString("dd MMMM yyyy, dddd")">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ReceiptLong" Href="/transactions">
                Tüm İşlemler
            </MudButton>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="Toplam müşteri" Value="@totalCustomerCount.ToString("N0")" Icon="@Icons.Material.Outlined.People"
                          OnClick="@(() => NavigationManager.NavigateTo("/customers"))" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="Borçlu müşteri" Value="@indebtedCustomersCount.ToString("N0")" Icon="@Icons.Material.Outlined.AccountBalanceWallet"
                          Tone="giden" Hint="En az bir kalemde giden bakiyesi olan" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="Bugünkü işlem" Value="@todayTransactionCount.ToString("N0")" Icon="@Icons.Material.Outlined.Today" Tone="info" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="Bu ayki işlem" Value="@currentMonthTransactionCount.ToString("N0")" Icon="@Icons.Material.Outlined.CalendarMonth"
                          Hint="@(string.IsNullOrEmpty(mostActiveCurrencyName) ? null : $"En çok: {mostActiveCurrencyName}")" />
            </MudItem>
        </MudGrid>

        <div class="kd-section-title">
            <div>
                <MudText Typo="Typo.h6">Bakiyeler</MudText>
                <MudText Typo="Typo.caption" Class="kd-muted">Tüm müşterilerin para birimi bazında açık bakiyeleri. Tutara tıklayınca ilgili müşteriler listelenir.</MudText>
            </div>
        </div>

        @if (!activeBalanceRows.Any())
        {
            <div class="kd-card"><EmptyState Icon="@Icons.Material.Outlined.Savings" Title="Açık bakiye yok" Text="Tüm müşteri hesapları sıfır." /></div>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var row in activeBalanceRows)
                {
                    <MudItem xs="12" sm="6" md="4" xl="3">
                        <div class="kd-card kd-balance-tile @(row.Difference > 0 ? "is-giden" : row.Difference < 0 ? "is-gelen" : "")">
                            <div class="d-flex justify-space-between align-center">
                                <span class="kd-tile-label">@row.CurrencyType.GetDisplayName()</span>
                                <BalanceAmount Balance="row.Difference" Currency="row.CurrencyType" ZeroText="Dengede" Class="kd-strong" />
                            </div>
                            <div class="d-flex mt-3" style="gap:8px">
                                <div class="flex-1 kd-clickable pa-2" style="border-radius:8px; flex:1" title="Giden bakiyesi olan müşteriler"
                                     @onclick="@(() => ShowBalanceDetails(row, isOutgoing: true))">
                                    <div class="kd-tile-hint">Giden</div>
                                    <div class="kd-num kd-giden kd-strong">@FormatHelper.FormatPrice(row.TotalOutgoing) @row.CurrencyType.GetSymbol()</div>
                                </div>
                                <div class="flex-1 kd-clickable pa-2" style="border-radius:8px; flex:1" title="Gelen bakiyesi olan müşteriler"
                                     @onclick="@(() => ShowBalanceDetails(row, isOutgoing: false))">
                                    <div class="kd-tile-hint">Gelen</div>
                                    <div class="kd-num kd-gelen kd-strong">@FormatHelper.FormatPrice(row.TotalIncoming) @row.CurrencyType.GetSymbol()</div>
                                </div>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>

            @if (showBalanceDetails)
            {
                <div id="balance-detail-panel" class="kd-card mt-4">
                    <div class="kd-card-header">
                        <MudText Typo="Typo.subtitle1">@balanceDetailTitle</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseBalanceDetails" aria-label="Kapat" />
                    </div>
                    @if (balanceDetailList.Any())
                    {
                        @foreach (var item in balanceDetailList)
                        {
                            <div class="kd-list-row kd-clickable" @onclick="@(() => NavigateToCustomer(item.CustomerId))">
                                <Avatar Name="@item.CustomerName" />
                                <div style="flex:1">@item.CustomerName</div>
                                <BalanceAmount Balance="item.NetBalance" Currency="item.CurrencyType" ShowDirection="false" Class="kd-strong" />
                            </div>
                        }
                        <div class="kd-list-row" style="background: var(--mud-palette-background-gray)">
                            <div style="flex:1" class="kd-strong">Toplam (@balanceDetailList.Count müşteri)</div>
                            <BalanceAmount Balance="@balanceDetailList.Sum(b => b.NetBalance)" Currency="balanceDetailList[0].CurrencyType" ShowDirection="false" Class="kd-strong" />
                        </div>
                    }
                    else
                    {
                        <EmptyState Title="Bu tutarla ilişkili müşteri yok." />
                    }
                </div>
            }
        }

        <MudGrid Spacing="3" Class="mt-2">
            <MudItem xs="12" lg="8">
                <div class="kd-section-title"><MudText Typo="Typo.h6">Son İşlemler</MudText></div>
                <div class="kd-card">
                    @if (!recentTransactions.Any())
                    {
                        <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong" Title="Henüz işlem yok" Text="Bir müşteri açıp ilk işlemi ekleyin." />
                    }
                    else
                    {
                        @foreach (var t in recentTransactions)
                        {
                            var name = customerNames.TryGetValue(t.CustomerId, out var n) ? n : "Bilinmeyen müşteri";
                            <div class="kd-list-row kd-clickable" @onclick="@(() => NavigateToCustomer(t.CustomerId))">
                                <Avatar Name="@name" />
                                <div style="flex:1; min-width:0">
                                    <div class="kd-strong" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@name</div>
                                    <div class="kd-muted" style="font-size:.78rem">@t.Date.ToString("dd.MM.yyyy HH:mm") · @t.CurrencyType.GetDisplayName()</div>
                                </div>
                                <TypeBadge Type="t.Type" IsDeposit="t.IsDeposit" />
                                <div class="kd-num kd-strong" style="min-width:120px; text-align:right">
                                    @FormatHelper.FormatPrice(t.Amount) @t.CurrencyType.GetSymbol()
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudItem>
            <MudItem xs="12" lg="4">
                <div class="kd-section-title"><MudText Typo="Typo.h6">En Aktif Müşteriler</MudText></div>
                <div class="kd-card">
                    @if (!topCustomers.Any())
                    {
                        <EmptyState Title="Henüz işlem yok" />
                    }
                    else
                    {
                        @foreach (var c in topCustomers)
                        {
                            <div class="kd-list-row kd-clickable" @onclick="@(() => NavigateToCustomer(c.CustomerId))">
                                <Avatar Name="@c.CustomerName" />
                                <div style="flex:1">@c.CustomerName</div>
                                <span class="kd-badge notr">@c.TransactionCount işlem</span>
                            </div>
                        }
                    }
                </div>
            </MudItem>
        </MudGrid>

        <div class="kd-section-title"><MudText Typo="Typo.h6">İşlem Hareketleri</MudText></div>
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8">
                <div class="kd-card kd-card-pad">
                    <MudText Typo="Typo.subtitle2" Class="kd-muted mb-2">Son 6 ay · işlem sayısı</MudText>
                    <MudChart ChartType="ChartType.Bar" ChartSeries="monthlyTransactionSeries" XAxisLabels="monthLabels"
                              ChartOptions="barOptions" Width="100%" Height="300px" />
                </div>
            </MudItem>
            <MudItem xs="12" lg="4">
                <div class="kd-card kd-card-pad" style="height:100%">
                    <MudText Typo="Typo.subtitle2" Class="kd-muted mb-2">Para birimine göre dağılım</MudText>
                    @if (currencyDistributionData.Length > 0)
                    {
                        <MudChart ChartType="ChartType.Donut" InputData="currencyDistributionData" InputLabels="currencyLabels"
                                  ChartOptions="donutOptions" Width="100%" Height="260px" />
                    }
                </div>
            </MudItem>
        </MudGrid>
    }
</div>

@code {
    private bool isLoading = true;
    private string greeting = "Hoş geldiniz";

    private int totalCustomerCount;
    private int indebtedCustomersCount;
    private int currentMonthTransactionCount;
    private int todayTransactionCount;
    private string mostActiveCurrencyName = string.Empty;

    private double[] currencyDistributionData = Array.Empty<double>();
    private string[] currencyLabels = Array.Empty<string>();
    private List<ChartSeries> monthlyTransactionSeries = new();
    private string[] monthLabels = Array.Empty<string>();

    // Altın tonları ve Giden/Gelen ile karışmayan nötr renkler
    private static readonly string[] ChartPalette = { "#B8860B", "#5B4A36", "#2F6FB0", "#8C9A5B", "#C9A86A", "#7A6F9B" };
    private readonly ChartOptions barOptions = new() { ChartPalette = ChartPalette, YAxisTicks = 5, ShowToolTips = true };
    private readonly ChartOptions donutOptions = new() { ChartPalette = ChartPalette, ShowToolTips = true };

    private List<CustomerActivityData> topCustomers = new();
    private List<Transaction> recentTransactions = new();
    private Dictionary<int, string> customerNames = new();

    private CurrencyBalanceSummaryResult? currencyBalanceSummary;
    private List<CurrencyBalanceRow> activeBalanceRows = new();

    private bool showBalanceDetails;
    private string balanceDetailTitle = string.Empty;
    private List<CustomerCurrencyBalance> balanceDetailList = new();
    private bool scrollToBalanceDetails;

    protected override async Task OnInitializedAsync()
    {
        var settings = await DatabaseService.GetSettingsAsync();
        var hour = DateTime.Now.Hour;
        var salute = hour < 12 ? "Günaydın" : hour < 18 ? "İyi günler" : "İyi akşamlar";
        greeting = string.IsNullOrWhiteSpace(settings.BusinessName) ? salute : $"{salute}, {settings.BusinessName}";

        await LoadDashboardData();
        await LoadCurrencyBalanceSummary();
        isLoading = false;
    }

    private async Task LoadDashboardData()
    {
        try
        {
            totalCustomerCount = await DatabaseService.GetCustomerCountAsync(string.Empty);
            indebtedCustomersCount = await DatabaseService.GetIndebtedCustomersCountAsync();

            var customers = await DatabaseService.GetCustomersAsync();
            customerNames = customers.ToDictionary(c => c.Id, c => c.Name);

            var all = (await DatabaseService.GetTransactionsAsync()).Where(t => !t.IsDeleted).ToList();
            var regular = all.Where(t => !t.IsDeposit).ToList();

            var now = DateTime.Now;
            var monthStart = new DateTime(now.Year, now.Month, 1);
            currentMonthTransactionCount = regular.Count(t => t.Date >= monthStart && t.Date < monthStart.AddMonths(1));
            todayTransactionCount = all.Count(t => t.Date.Date == now.Date);

            var mostActive = await DatabaseService.GetMostActiveCurrencyTypeAsync();
            mostActiveCurrencyName = mostActive.TransactionCount > 0 ? mostActive.CurrencyType.GetDisplayName() : string.Empty;

            CalculateCurrencyDistribution(regular);
            CalculateMonthlyTransactions(regular);

            topCustomers = regular
                .Where(t => t.CustomerId > 0 && customerNames.ContainsKey(t.CustomerId))
                .GroupBy(t => t.CustomerId)
                .Select(g => new CustomerActivityData { CustomerId = g.Key, CustomerName = customerNames[g.Key], TransactionCount = g.Count() })
                .OrderByDescending(c => c.TransactionCount)
                .Take(6)
                .ToList();

            recentTransactions = all
                .Where(t => !t.IsHidden)
                .OrderByDescending(t => t.Date).ThenByDescending(t => t.Id)
                .Take(8)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ana sayfa verisi yüklenirken hata: {ex.Message}");
        }
    }

    private void CalculateCurrencyDistribution(List<Transaction> transactions)
    {
        var groups = transactions.GroupBy(t => t.CurrencyType)
            .Select(g => (Currency: g.Key, Count: g.Count()))
            .OrderByDescending(g => g.Count)
            .ToList();

        var top = groups.Take(5).ToList();
        var other = groups.Skip(5).Sum(g => g.Count);

        var data = top.Select(g => (double)g.Count).ToList();
        var labels = top.Select(g => g.Currency.GetDisplayName()).ToList();
        if (other > 0)
        {
            data.Add(other);
            labels.Add("Diğer");
        }

        currencyDistributionData = data.ToArray();
        currencyLabels = labels.ToArray();
    }

    private void CalculateMonthlyTransactions(List<Transaction> transactions)
    {
        var monthStart = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        var months = Enumerable.Range(0, 6).Select(i => monthStart.AddMonths(i - 5)).ToList();

        static bool IsGold(CurrencyType c) => c is CurrencyType.Gold14K or CurrencyType.Gold22K or CurrencyType.Gold24K
            or CurrencyType.QuarterGold or CurrencyType.HalfGold or CurrencyType.FullGold or CurrencyType.Ziynet;
        static bool IsForeign(CurrencyType c) => c is CurrencyType.Dollar or CurrencyType.Euro or CurrencyType.Sterlin or CurrencyType.Riyal;

        double[] Count(Func<CurrencyType, bool> filter) => months
            .Select(m => (double)transactions.Count(t => t.Date >= m && t.Date < m.AddMonths(1) && filter(t.CurrencyType)))
            .ToArray();

        monthlyTransactionSeries = new List<ChartSeries>
        {
            new() { Name = "Altın", Data = Count(IsGold) },
            new() { Name = "TL", Data = Count(c => c == CurrencyType.TurkishLira) },
            new() { Name = "Döviz", Data = Count(IsForeign) },
        };
        monthLabels = months.Select(m => m.ToString("MMM yy")).ToArray();
    }

    private async Task LoadCurrencyBalanceSummary()
    {
        try
        {
            var r = await DatabaseService.GetCurrencyBalanceSummaryAsync();
            currencyBalanceSummary = r;

            var rows = new List<CurrencyBalanceRow>
            {
                new(CurrencyType.TurkishLira, r.ToplamGelenTL, r.ToplamGidenTL),
                new(CurrencyType.Gold24K, r.ToplamGelen24Ayar, r.ToplamGiden24Ayar),
                new(CurrencyType.Gold22K, r.ToplamGelen22Ayar, r.ToplamGiden22Ayar),
                new(CurrencyType.Gold14K, r.ToplamGelen14Ayar, r.ToplamGiden14Ayar),
                new(CurrencyType.QuarterGold, r.ToplamGelenCeyrekAltin, r.ToplamGidenCeyrekAltin),
                new(CurrencyType.HalfGold, r.ToplamGelenYarimAltin, r.ToplamGidenYarimAltin),
                new(CurrencyType.FullGold, r.ToplamGelenTamAltin, r.ToplamGidenTamAltin),
                new(CurrencyType.Ziynet, r.ToplamGelenZiynetAltin, r.ToplamGidenZiynetAltin),
                new(CurrencyType.Dollar, r.ToplamGelenDolar, r.ToplamGidenDolar),
                new(CurrencyType.Euro, r.ToplamGelenEuro, r.ToplamGidenEuro),
                new(CurrencyType.Sterlin, r.ToplamGelenSterlin, r.ToplamGidenSterlin),
                new(CurrencyType.Riyal, r.ToplamGelenRiyal, r.ToplamGidenRiyal),
            };
            activeBalanceRows = rows.Where(x => x.TotalIncoming != 0 || x.TotalOutgoing != 0).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Para birimi bakiye özeti yüklenirken hata: {ex.Message}");
        }
    }

    // Giden / Gelen tutarına tıklandığında ilgili müşterileri listeler
    private void ShowBalanceDetails(CurrencyBalanceRow row, bool isOutgoing)
    {
        if ((isOutgoing ? row.TotalOutgoing : row.TotalIncoming) == 0)
        {
            CloseBalanceDetails();
            return;
        }

        // NetBalance > 0 → giden, < 0 → gelen
        balanceDetailList = (currencyBalanceSummary?.CustomerBalances ?? new List<CustomerCurrencyBalance>())
            .Where(cb => cb.CurrencyType == row.CurrencyType && (isOutgoing ? cb.NetBalance > 0 : cb.NetBalance < 0))
            .OrderByDescending(cb => Math.Abs(cb.NetBalance))
            .ToList();

        balanceDetailTitle = $"{row.CurrencyType.GetDisplayName()} · {(isOutgoing ? "Giden" : "Gelen")} bakiyesi olan müşteriler";
        showBalanceDetails = true;
        scrollToBalanceDetails = true;
    }

    private void CloseBalanceDetails()
    {
        showBalanceDetails = false;
        balanceDetailList = new List<CustomerCurrencyBalance>();
    }

    private void NavigateToCustomer(int customerId) => NavigationManager.NavigateTo($"/customer/{customerId}");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToBalanceDetails)
        {
            scrollToBalanceDetails = false;
            await JS.InvokeVoidAsync("kuyumcu.scrollIntoView", "balance-detail-panel");
        }
    }

    private sealed record CurrencyBalanceRow(CurrencyType CurrencyType, decimal TotalIncoming, decimal TotalOutgoing)
    {
        public decimal Difference => TotalOutgoing - TotalIncoming;
    }
}
