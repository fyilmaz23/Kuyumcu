@page "/license-expired"
@layout Kuyumcu.Components.Layout.BareLayout
@inject AppState AppState
@inject Services.LicenseService LicenseService
@inject Services.DatabaseService DatabaseService
@inject NavigationManager NavigationManager

<div class="kd-card kd-gate">
    @if (state == null)
    {
        <MudProgressCircular Indeterminate="true" Class="d-block mx-auto my-8" />
    }
    else
    {
        <div class="kd-gate-head">
            <div class="kd-gate-icon"><MudIcon Icon="@Icons.Material.Filled.Lock" /></div>
            <div>
                <MudText Typo="Typo.h5" Class="kd-strong">@Title</MudText>
                <MudText Typo="Typo.body2" Class="kd-muted">@Description</MudText>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(businessName))
        {
            <div class="kd-gate-business">
                <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" /> @businessName
            </div>
        }

        <LicensePanel State="state" OnActivated="OnActivated" FullWidthButton="true" HideStatus="true" />

        <MudText Typo="Typo.caption" Class="kd-muted d-block mt-4">
            Verileriniz silinmedi; lisans girildiğinde kaldığınız yerden devam edersiniz.
            Yedek almak veya yedeği içe aktarmak için <MudLink Href="settings" Typo="Typo.caption">Ayarlar</MudLink> açıktır.
        </MudText>
    }
</div>

@code {
    private LicenseState? state;
    private string businessName = string.Empty;

    private string Title => state?.LockReason switch
    {
        LicenseLockReason.LicenseEnded => "Lisans süresi doldu",
        LicenseLockReason.LicenseInvalid => "Lisans yenilenmeli",
        _ => "Deneme süresi doldu",
    };

    private string Description => state?.LockReason switch
    {
        LicenseLockReason.LicenseEnded => "Süreli lisansınız sona erdi. Devam etmek için yeni lisans anahtarı girin.",
        LicenseLockReason.LicenseInvalid => "Kayıtlı lisans anahtarı bu sürümde geçerli değil. Yetkilinizden yeni anahtar isteyin.",
        _ => "30 günlük deneme süreniz sona erdi. Uygulamayı kullanmaya devam etmek için lisans anahtarı girin.",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            businessName = (await DatabaseService.GetSettingsAsync()).BusinessName;
            state = await LicenseService.GetLicenseStateAsync();

            // Lisans geçerliyse (veya deneme sürüyorsa) bu ekranda durmaya gerek yok
            if (state.Status != LicenseStatus.Expired)
                OnActivated();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LicenseExpired OnInitialized hata: {ex.Message}");
            state = new LicenseState { Status = LicenseStatus.Expired };
        }
    }

    private void OnActivated()
    {
        AppState.IsLicenseExpired = false;
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
