@page "/settings"
@inject DatabaseService DatabaseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject Services.LicenseService LicenseService
@inject GoogleDriveService GoogleDriveService
@inject BackupService BackupService
@inject IFilePickerService FilePicker
@inject IShareService ShareService
@inject ILegacyDataLocator LegacyDataLocator
@inject AppState AppState

<div class="kd-page">
    <PageHeader Title="Ayarlar" Subtitle="İş yeri bilgileri, lisans, yedekleme ve veri aktarma">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveSettings" Disabled="@(isLoading || string.IsNullOrWhiteSpace(settings.BusinessName))">
                Kaydet
            </MudButton>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Class="d-block mx-auto my-8" />
    }
    else
    {
        @if (legacyDatabasePath != null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" ContentAlignment="HorizontalAlignment.Left">
                <div class="d-flex align-center gap-3 flex-wrap">
                    <span><b>Eski sürümün verileri bulundu.</b> Müşterilerinizi, işlemlerinizi ve ayarlarınızı bu sürüme tek tıkla aktarabilirsiniz.</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.MoveDown"
                               OnClick="ImportLegacyData" Disabled="@isRestoreInProgress">
                        Eski Verileri Aktar
                    </MudButton>
                </div>
            </MudAlert>
        }

        <div class="kd-settings-grid">
            @* ---- Sol sütun: "Kaydet" ile saklanan ayarlar ---- *@
            <div class="kd-settings-col">
                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.Storefront" /> İş Yeri</div>
                    </div>
                    <div class="kd-card-pad">
                        <MudTextField @bind-Value="settings.BusinessName" Label="İş yeri adı" Variant="Variant.Outlined"
                                      Required="true" RequiredError="İş yeri adı zorunludur"
                                      HelperText="Üst menüde ve müşteri özetlerinde görünür." />
                    </div>
                </section>

                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.CurrencyExchange" /> Altın Fiyatı Görseli</div>
                    </div>
                    <div class="kd-card-pad">
                        <MudText Typo="Typo.body2" Class="kd-muted mb-3">
                            Mobil uygulamadaki "Altın fiyatlarını paylaş" özelliği için fiyat.ekeo.org.tr üyelik bilgileri.
                            Bu bilgiler yedekle birlikte telefonunuza aktarılır.
                        </MudText>
                        <div class="kd-form-row">
                            <MudTextField @bind-Value="settings.GoldPriceSiteCode" Label="Üye kodu" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="settings.GoldPriceSitePassword" Label="Şifre" Variant="Variant.Outlined"
                                          InputType="InputType.Password" />
                        </div>

                        <div class="d-flex align-center gap-2 flex-wrap mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Image"
                                       OnClick="PickGoldPriceTemplate">
                                @(settings.GoldPriceTemplateImage is { Length: > 0 } ? "Şablonu Değiştir" : "Şablon Görseli Yükle")
                            </MudButton>
                            @if (settings.GoldPriceTemplateImage is { Length: > 0 })
                            {
                                <span class="kd-badge gelen"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                    Şablon yüklendi (@(settings.GoldPriceTemplateImage.Length / 1024) KB)</span>
                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => settings.GoldPriceTemplateImage = null)">Kaldır</MudButton>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="kd-muted">Şablon yüklenmezse sade bir tasarım kullanılır.</MudText>
                            }
                        </div>
                    </div>
                </section>

                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.CloudUpload" /> Google Drive Yedekleme</div>
                        @if (ProductSecrets.HasBuiltInGoogleClient || settings.HasCustomGoogleClient)
                        {
                            <span class="kd-badge gelen">Hazır</span>
                        }
                        else
                        {
                            <span class="kd-badge giden">Ayarlanmamış</span>
                        }
                    </div>
                    <div class="kd-card-pad">
                        @if (ProductSecrets.HasBuiltInGoogleClient || settings.HasCustomGoogleClient)
                        {
                            <MudText Typo="Typo.body2" Class="kd-muted">
                                Üst menüdeki <b>bulut</b> düğmesine ilk bastığınızda tarayıcıda Google hesabınızla giriş yapmanız
                                istenir; sonraki yedeklemeler otomatik bağlanır.
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="kd-muted">
                                Google Drive bağlantısı bu derlemede tanımlı değil. Aşağıdaki gelişmiş ayarlardan kendi OAuth bilgilerinizi girebilirsiniz.
                            </MudText>
                        }

                        <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                            <MudExpansionPanel Text="Gelişmiş: kendi Google OAuth bilgilerim">
                                <MudText Typo="Typo.caption" Class="kd-muted mb-3 d-block">
                                    Sadece kendi Google Cloud projenizi kullanmak istiyorsanız doldurun. Boş bırakırsanız uygulamanın kendi bağlantısı kullanılır.
                                </MudText>
                                <MudTextField @bind-Value="settings.GoogleClientId" Label="Google Client ID" Variant="Variant.Outlined" Class="mb-3" />
                                <MudTextField @bind-Value="settings.GoogleClientSecret" Label="Google Client Secret" Variant="Variant.Outlined"
                                              InputType="InputType.Password" />
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </div>
                </section>
            </div>

            @* ---- Sağ sütun: lisans ve veri işlemleri (anında uygulanır) ---- *@
            <div class="kd-settings-col">
                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" /> Lisans</div>
                    </div>
                    <div class="kd-card-pad">
                        @if (licenseState != null)
                        {
                            <LicensePanel State="licenseState" OnActivated="ReloadLicense" />
                        }
                    </div>
                </section>

                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.Backup" /> Bilgisayardaki Yedekler</div>
                    </div>
                    <div class="kd-card-pad">
                        <MudText Typo="Typo.body2" Class="kd-muted">
                            Uygulama bu bilgisayara otomatik yedek alır ve son @BackupService.DaysToKeep günün yedeklerini saklar.
                        </MudText>
                        <div class="kd-kv mt-2">
                            <span>Son yedek</span><b>@(lastLocalBackup ?? "henüz yok")</b>
                        </div>
                        <div class="d-flex gap-2 flex-wrap mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Backup"
                                       OnClick="BackupLocalNow" Disabled="@isLocalBackupInProgress">
                                @(isLocalBackupInProgress ? "Yedekleniyor…" : "Şimdi Yedekle")
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FolderOpen"
                                       OnClick="OpenBackupFolder">
                                Yedek Klasörünü Aç
                            </MudButton>
                        </div>
                    </div>
                </section>

                <section class="kd-card kd-card-danger">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.RestorePage" /> Yedeği İçe Aktar</div>
                    </div>
                    <div class="kd-card-pad">
                        <MudText Typo="Typo.body2" Class="kd-muted">
                            Daha önce alınmış bir .db3 yedeğiyle müşteri ve işlem verilerini <b>tamamen değiştirir</b>.
                            Bu bilgisayarın ayarları ve lisansı korunur; işlemden önce otomatik bir yerel yedek alınır.
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="mt-3"
                                   StartIcon="@Icons.Material.Outlined.FileUpload" OnClick="RestoreDatabase" Disabled="@isRestoreInProgress">
                            @(isRestoreInProgress ? "İçe aktarılıyor…" : "Yedek Dosyası Seç ve İçe Aktar")
                        </MudButton>
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    private AppSettings settings = new();
    private bool isLoading = true;
    private bool isRestoreInProgress;
    private bool isLocalBackupInProgress;
    private string? lastLocalBackup;
    private string? legacyDatabasePath;
    private LicenseState? licenseState;

    protected override async Task OnInitializedAsync()
    {
        settings = await DatabaseService.GetSettingsAsync();
        RefreshLocalBackupInfo();

        try
        {
            legacyDatabasePath = LegacyDataLocator.FindLegacyDatabase();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eski sürüm verisi aranırken hata: {ex.Message}");
        }

        await ReloadLicense();
        isLoading = false;
    }

    private async Task ReloadLicense()
    {
        try
        {
            licenseState = await LicenseService.GetLicenseStateAsync();
            AppState.IsLicenseExpired = licenseState.Status == LicenseStatus.Expired;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Settings lisans kontrolü hata: {ex.Message}");
        }
    }

    private void RefreshLocalBackupInfo()
    {
        var latest = BackupService.GetBackupsList().FirstOrDefault();
        lastLocalBackup = latest == null ? null : File.GetLastWriteTime(latest).ToString("dd.MM.yyyy HH:mm");
    }

    private async Task SaveSettings()
    {
        if (string.IsNullOrWhiteSpace(settings.BusinessName))
            return;

        settings.IsSetupCompleted = true;
        await DatabaseService.SaveSettingsAsync(settings);
        AppState.IsSetupCompleted = true;
        GoogleDriveService.ResetConnection();

        Snackbar.Add("Ayarlar kaydedildi.", Severity.Success);
    }

    private async Task PickGoldPriceTemplate()
    {
        var file = await FilePicker.PickFileAsync("Altın fiyatı şablon görseli seçin", ".jpg", ".jpeg", ".png");
        if (file == null)
            return;

        var bytes = await File.ReadAllBytesAsync(file.FullPath);
        if (bytes.Length > 5 * 1024 * 1024)
        {
            Snackbar.Add("Görsel 5 MB'tan küçük olmalıdır.", Severity.Warning);
            return;
        }

        settings.GoldPriceTemplateImage = bytes;
        Snackbar.Add("Şablon seçildi. Kalıcı olması için Kaydet'e basın.", Severity.Info);
    }

    private async Task BackupLocalNow()
    {
        isLocalBackupInProgress = true;
        try
        {
            var path = await BackupService.BackupNowAsync();
            if (path != null)
                Snackbar.Add("Yerel yedek alındı.", Severity.Success);
            else
                Snackbar.Add("Yedek alınamadı.", Severity.Error);
            RefreshLocalBackupInfo();
        }
        finally
        {
            isLocalBackupInProgress = false;
        }
    }

    private async Task OpenBackupFolder()
    {
        var latest = BackupService.GetBackupsList().FirstOrDefault();
        if (latest == null)
        {
            Snackbar.Add("Henüz yerel yedek yok.", Severity.Info);
            return;
        }
        await ShareService.ShareFileAsync(latest, "Yerel yedek");
    }

    private async Task ImportLegacyData()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Eski Verileri Aktar",
            "Eski sürümdeki müşteri, işlem ve ayarlarınız bu sürüme aktarılacak. Bu sürümde girdiğiniz veriler varsa üzerine yazılır.\n\nDevam edilsin mi?",
            yesText: "Aktar",
            noText: "Vazgeç");
        if (confirm != true || legacyDatabasePath == null)
            return;

        isRestoreInProgress = true;
        StateHasChanged();
        try
        {
            await BackupService.BackupNowAsync();
            var result = await DatabaseService.RestoreDatabaseAsync(legacyDatabasePath, keepCurrentSettingsAndLicense: false);
            if (result.Success)
            {
                LegacyDataLocator.MarkImported();
                await DialogService.ShowMessageBox("Başarılı", result.Message, yesText: "Tamam");
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                await DialogService.ShowMessageBox("Hata", result.Message, yesText: "Tamam");
            }
        }
        finally
        {
            isRestoreInProgress = false;
            StateHasChanged();
        }
    }

    private async Task RestoreDatabase()
    {
        var firstConfirm = await DialogService.ShowMessageBox(
            "Yedeği İçe Aktar",
            "Bu işlem mevcut TÜM müşteri ve işlem verilerinizi seçeceğiniz yedek dosyasındaki verilerle değiştirecektir.\n\nDevam etmek istiyor musunuz?",
            yesText: "Evet, Devam Et",
            noText: "İptal");

        if (firstConfirm != true) return;

        try
        {
            var file = await FilePicker.PickFileAsync("Yedek dosyasını seçin (.db3)", ".db3", ".db");
            if (file == null) return;

            var finalConfirm = await DialogService.ShowMessageBox(
                "Son Onay",
                $"Seçilen dosya: {file.FileName}\n\nMevcut müşteri ve işlem verileri bu dosyadakilerle değiştirilecek. Emin misiniz?",
                yesText: "Evet, İçe Aktar",
                noText: "Vazgeç");

            if (finalConfirm != true) return;

            isRestoreInProgress = true;
            StateHasChanged();

            // Geri dönüş imkânı için önce mevcut verinin yerel yedeğini al
            await BackupService.BackupNowAsync();

            var result = await DatabaseService.RestoreDatabaseAsync(file.FullPath);

            if (result.Success)
            {
                await DialogService.ShowMessageBox("Başarılı", result.Message, yesText: "Tamam");
                NavigationManager.NavigateTo("/");
            }
            else
            {
                await DialogService.ShowMessageBox("Hata", result.Message, yesText: "Tamam");
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBox("Hata", $"Dosya seçilirken bir hata oluştu: {ex.Message}", yesText: "Tamam");
        }
        finally
        {
            isRestoreInProgress = false;
            StateHasChanged();
        }
    }
}
