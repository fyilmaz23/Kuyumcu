@page "/settings"
@inject DatabaseService DatabaseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject Services.LicenseService LicenseService
@inject GoogleDriveService GoogleDriveService
@inject BackupService BackupService
@inject IFilePickerService FilePicker
@inject IShareService ShareService
@inject ILegacyDataLocator LegacyDataLocator
@inject AppState AppState
@inject CloudBackupService CloudBackup
@inject GoldPriceExportService GoldPriceExportService
@implements IDisposable

<div class="kd-page">
    <PageHeader Title="Ayarlar" Subtitle="İş yeri bilgileri, lisans, yedekleme ve veri aktarma">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveSettings" Disabled="@(isLoading || string.IsNullOrWhiteSpace(settings.BusinessName))">
                Kaydet
            </MudButton>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Class="d-block mx-auto my-8" />
    }
    else
    {
        @if (legacyDatabasePath != null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" ContentAlignment="HorizontalAlignment.Left">
                <div class="d-flex align-center gap-3 flex-wrap">
                    <span><b>Eski sürümün verileri bulundu.</b> Müşterilerinizi, işlemlerinizi ve ayarlarınızı bu sürüme tek tıkla aktarabilirsiniz.</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.MoveDown"
                               OnClick="ImportLegacyData" Disabled="@isRestoreInProgress">
                        Eski Verileri Aktar
                    </MudButton>
                </div>
            </MudAlert>
        }

        <div class="kd-settings-grid">
            @* ---- Sol sütun: "Kaydet" ile saklanan ayarlar ---- *@
            <div class="kd-settings-col">
                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.Storefront" /> İş Yeri</div>
                    </div>
                    <div class="kd-card-pad">
                        <MudTextField @bind-Value="settings.BusinessName" Label="İş yeri adı" Variant="Variant.Outlined"
                                      Required="true" RequiredError="İş yeri adı zorunludur"
                                      HelperText="Üst menüde ve müşteri özetlerinde görünür." />
                        <MudTextField @bind-Value="settings.ReceiptTitle" Label="Fiş başlığı" Variant="Variant.Outlined" Class="mt-4"
                                      Placeholder="@(string.IsNullOrWhiteSpace(settings.BusinessName) ? null : settings.BusinessName)"
                                      HelperText="Yazdırılan müşteri fişinin en üstünde. Boş bırakılırsa iş yeri adı basılır." />
                        <MudTextField @bind-Value="settings.ReceiptFooter" Label="Fiş alt yazısı" Variant="Variant.Outlined" Class="mt-4"
                                      Lines="2" AutoGrow="true" MaxLines="@ReceiptTexts.MaxFooterLines"
                                      Placeholder="ör. @@kuyumcuadiniz · 0555 555 55 55"
                                      HelperText="@($"Fişin altına basılır (Instagram, telefon, adres…). En fazla {ReceiptTexts.MaxFooterLines} satır; boşsa basılmaz.")" />
                    </div>
                </section>

                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.CurrencyExchange" /> Altın Fiyatı Görseli</div>
                    </div>
                    <div class="kd-card-pad">
                        <MudText Typo="Typo.body2" Class="kd-muted mb-3">
                            Ana sayfadaki ve mobil uygulamadaki "fiyat görselini paylaş" özelliği için. Fiyatlar @GoldPriceExportService.SourceName
                            adresinden alınır; üyelik veya şifre gerekmez. Şablon görseli yedekle birlikte telefonunuza aktarılır.
                        </MudText>

                        <div class="d-flex align-center gap-2 flex-wrap mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Image"
                                       OnClick="PickGoldPriceTemplate">
                                @(settings.GoldPriceTemplateImage is { Length: > 0 } ? "Şablonu Değiştir" : "Şablon Görseli Yükle")
                            </MudButton>
                            @if (settings.GoldPriceTemplateImage is { Length: > 0 })
                            {
                                <span class="kd-badge gelen"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                    Şablon yüklendi (@(settings.GoldPriceTemplateImage.Length / 1024) KB)</span>
                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => settings.GoldPriceTemplateImage = null)">Kaldır</MudButton>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="kd-muted">Şablon yüklenmezse sade bir tasarım kullanılır.</MudText>
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Visibility"
                                       OnClick="@(() => GoldPriceShareDialog.ShowWithTemplateAsync(DialogService, settings.GoldPriceTemplateImage, settings.BusinessName))">
                                Önizle / Paylaş
                            </MudButton>
                        </div>
                    </div>
                </section>

                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.CloudUpload" /> Google Drive Yedekleme</div>
                        <span class="kd-badge @CloudBadgeClass">@CloudBadgeText</span>
                    </div>
                    <div class="kd-card-pad">
                        @switch (cloud.Health)
                        {
                            case CloudBackupHealth.NotConfigured:
                                <MudText Typo="Typo.body2" Class="kd-muted">
                                    Google Drive bağlantısı bu derlemede tanımlı değil. Aşağıdaki gelişmiş ayarlardan kendi OAuth bilgilerinizi
                                    girip Kaydet'e basın.
                                </MudText>
                                break;

                            case CloudBackupHealth.NotConnected:
                                <MudText Typo="Typo.body2" Class="kd-muted">
                                    Google hesabınızı bir kere bağlayın; uygulama verilerinizi <b>kendiliğinden</b> Drive'ınızdaki
                                    "@ProductInfo.DriveFolderName" klasörüne yedekler (değişiklik varsa 2 saatte bir ve kapanırken).
                                    Uygulama Drive'ınızda sadece kendi oluşturduğu dosyaları görebilir.
                                </MudText>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" StartIcon="@Icons.Material.Filled.Login"
                                           OnClick="ConnectDrive" Disabled="@isConnecting">
                                    @(isConnecting ? "Tarayıcıda Google girişi bekleniyor…" : "Google Hesabını Bağla")
                                </MudButton>
                                @if (isConnecting)
                                {
                                    <MudButton Variant="Variant.Text" Class="mt-3 ml-2" OnClick="CancelConnect">Vazgeç</MudButton>
                                }
                                break;

                            default:
                                @if (cloud.Health == CloudBackupHealth.NeedsReconnect || !string.IsNullOrEmpty(cloud.LastError))
                                {
                                    <MudAlert Severity="@(cloud.Health is CloudBackupHealth.NeedsReconnect or CloudBackupHealth.Failing ? Severity.Error : Severity.Warning)"
                                              Variant="Variant.Outlined" Dense="true" Class="mb-3">@cloud.LastError</MudAlert>
                                }
                                <div class="kd-kv"><span>Hesap</span><b>@(cloud.AccountEmail ?? "—")</b></div>
                                <div class="kd-kv mt-1"><span>Son yedek</span><b>@TimeAgo.Format(cloud.LastSuccessUtc)</b></div>
                                @if (cloud.LastVerifiedUtc > cloud.LastSuccessUtc)
                                {
                                    <div class="kd-kv mt-1"><span>Son kontrol (değişiklik yok)</span><b>@TimeAgo.Format(cloud.LastVerifiedUtc)</b></div>
                                }
                                <MudText Typo="Typo.caption" Class="kd-muted d-block mt-2">
                                    Otomatik: değişiklik varsa 2 saatte bir ve uygulama kapanırken. Drive'da son 14 günün ve 12 ayın yedekleri saklanır.
                                </MudText>
                                <div class="d-flex gap-2 flex-wrap mt-3">
                                    @if (cloud.Health == CloudBackupHealth.NeedsReconnect)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login"
                                                   OnClick="ConnectDrive" Disabled="@isConnecting">
                                            @(isConnecting ? "Tarayıcıda Google girişi bekleniyor…" : "Yeniden Bağlan")
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.CloudUpload"
                                                   OnClick="CloudBackupNow" Disabled="@cloud.IsRunning">
                                            @(cloud.IsRunning ? "Yedekleniyor…" : "Şimdi Yedekle")
                                        </MudButton>
                                    }
                                    @if (!string.IsNullOrEmpty(cloud.FolderId))
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.OpenInNew"
                                                   Href="@GoogleDriveService.FolderWebLink(cloud.FolderId)" Target="_blank">
                                            Drive'da Aç
                                        </MudButton>
                                    }
                                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.LinkOff"
                                               OnClick="DisconnectDrive">
                                        Bağlantıyı Kes
                                    </MudButton>
                                </div>
                                break;
                        }

                        <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                            <MudExpansionPanel Text="Gelişmiş: kendi Google OAuth bilgilerim">
                                <MudText Typo="Typo.caption" Class="kd-muted mb-3 d-block">
                                    Sadece kendi Google Cloud projenizi kullanmak istiyorsanız doldurun. Boş bırakırsanız uygulamanın kendi bağlantısı kullanılır.
                                </MudText>
                                <MudTextField @bind-Value="settings.GoogleClientId" Label="Google Client ID" Variant="Variant.Outlined" Class="mb-3" />
                                <MudTextField @bind-Value="settings.GoogleClientSecret" Label="Google Client Secret" Variant="Variant.Outlined"
                                              InputType="InputType.Password" />
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </div>
                </section>
            </div>

            @* ---- Sağ sütun: lisans ve veri işlemleri (anında uygulanır) ---- *@
            <div class="kd-settings-col">
                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" /> Lisans</div>
                    </div>
                    <div class="kd-card-pad">
                        @if (licenseState != null)
                        {
                            <LicensePanel State="licenseState" OnActivated="ReloadLicense" />
                        }
                    </div>
                </section>

                <section class="kd-card">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.Backup" /> Bilgisayardaki Yedekler</div>
                    </div>
                    <div class="kd-card-pad">
                        <MudText Typo="Typo.body2" Class="kd-muted">
                            Uygulama bu bilgisayara günde bir otomatik yedek alır ve son @BackupService.DaysToKeep günün yedeklerini saklar.
                        </MudText>
                        <div class="kd-kv mt-2">
                            <span>Son yedek</span><b>@(lastLocalBackup ?? "henüz yok")</b>
                        </div>
                        <div class="d-flex gap-2 flex-wrap mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Backup"
                                       OnClick="BackupLocalNow" Disabled="@isLocalBackupInProgress">
                                @(isLocalBackupInProgress ? "Yedekleniyor…" : "Şimdi Yedekle")
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FolderOpen"
                                       OnClick="OpenBackupFolder">
                                Yedek Klasörünü Aç
                            </MudButton>
                        </div>
                    </div>
                </section>

                <section class="kd-card kd-card-danger">
                    <div class="kd-card-header">
                        <div class="kd-card-title"><MudIcon Icon="@Icons.Material.Outlined.RestorePage" /> Yedeği İçe Aktar</div>
                    </div>
                    <div class="kd-card-pad">
                        <MudText Typo="Typo.body2" Class="kd-muted">
                            Daha önce alınmış bir .db3 yedeğiyle müşteri, işlem ve stok verilerini <b>tamamen değiştirir</b>.
                            Bu bilgisayarın ayarları, etiket yazıcısı ayarı ve lisansı korunur; ürün kodu sayacı geri sarılmaz.
                            İşlemden önce otomatik bir yerel yedek alınır.
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="mt-3"
                                   StartIcon="@Icons.Material.Outlined.FileUpload" OnClick="RestoreDatabase" Disabled="@isRestoreInProgress">
                            @(isRestoreInProgress ? "İçe aktarılıyor…" : "Yedek Dosyası Seç ve İçe Aktar")
                        </MudButton>
                    </div>
                </section>
            </div>
        </div>

        @* ---- Barkodlu vitrin stoğu: bu bölümlerin kendi kaydet düğmeleri var ---- *@
        <div class="kd-settings-wide">
            @if (licenseState?.HasBarcodeModule == true)
            {
                <LabelPrinterSettingsSection />
                <StockDefinitionsSection />
            }
            else
            {
                <BarcodeModuleLocked Compact="true" />
            }
        </div>
    }
</div>

@code {
    private AppSettings settings = new();
    private bool isLoading = true;
    private bool isRestoreInProgress;
    private bool isLocalBackupInProgress;
    private string? lastLocalBackup;
    private string? legacyDatabasePath;
    private LicenseState? licenseState;
    private CloudBackupStatus cloud = new();
    private bool isConnecting;
    private CancellationTokenSource? connectCts;

    private string CloudBadgeClass => cloud.Health switch
    {
        CloudBackupHealth.UpToDate => "gelen",
        CloudBackupHealth.Warning => "emanet",
        CloudBackupHealth.NeedsReconnect or CloudBackupHealth.Failing => "giden",
        _ => "notr",
    };

    private string CloudBadgeText => cloud.Health switch
    {
        CloudBackupHealth.UpToDate => "Güncel",
        CloudBackupHealth.Warning => cloud.LastVerifiedUtc == null ? "Bekliyor" : "Uyarı",
        CloudBackupHealth.Failing => "Yedek alınamıyor",
        CloudBackupHealth.NeedsReconnect => "Yeniden bağlanın",
        CloudBackupHealth.NotConnected => "Bağlı değil",
        _ => "Ayarlanmamış",
    };

    protected override async Task OnInitializedAsync()
    {
        settings = await DatabaseService.GetSettingsAsync();
        RefreshLocalBackupInfo();

        CloudBackup.StatusChanged += OnCloudStatusChanged;
        await CloudBackup.RefreshConnectionAsync();
        cloud = CloudBackup.Status;

        try
        {
            legacyDatabasePath = LegacyDataLocator.FindLegacyDatabase();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eski sürüm verisi aranırken hata: {ex.Message}");
        }

        await ReloadLicense();
        isLoading = false;
    }

    private async Task ReloadLicense()
    {
        try
        {
            licenseState = await LicenseService.GetLicenseStateAsync();
            AppState.ApplyLicense(licenseState);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Settings lisans kontrolü hata: {ex.Message}");
        }
    }

    private void RefreshLocalBackupInfo()
    {
        var latest = BackupService.GetBackupsList().FirstOrDefault();
        lastLocalBackup = latest == null ? null : File.GetLastWriteTime(latest).ToString("dd.MM.yyyy HH:mm");
    }

    private async Task SaveSettings()
    {
        if (string.IsNullOrWhiteSpace(settings.BusinessName))
            return;

        settings.IsSetupCompleted = true;
        await DatabaseService.SaveSettingsAsync(settings);
        AppState.IsSetupCompleted = true;
        GoogleDriveService.ResetConnection();
        await CloudBackup.RefreshConnectionAsync();

        Snackbar.Add("Ayarlar kaydedildi.", Severity.Success);
    }

    private void OnCloudStatusChanged() => InvokeAsync(() =>
    {
        cloud = CloudBackup.Status;
        StateHasChanged();
    });

    private async Task ConnectDrive()
    {
        isConnecting = true;
        connectCts = new CancellationTokenSource(TimeSpan.FromMinutes(5));
        try
        {
            var email = await CloudBackup.ConnectAsync(connectCts.Token);
            Snackbar.Add($"Google Drive bağlandı{(email != null ? $" ({email})" : "")}. İlk yedek alınıyor…", Severity.Success);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Google girişi tamamlanmadı.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Google Drive bağlanamadı: {ex.Message}", Severity.Error);
        }
        finally
        {
            isConnecting = false;
            connectCts?.Dispose();
            connectCts = null;
            cloud = CloudBackup.Status;
        }
    }

    private void CancelConnect() => connectCts?.Cancel();

    private async Task CloudBackupNow()
    {
        var result = await CloudBackup.BackupNowAsync();
        Snackbar.Add(result.Message, result.Outcome switch
        {
            CloudBackupOutcome.Uploaded => Severity.Success,
            CloudBackupOutcome.Unchanged or CloudBackupOutcome.Busy => Severity.Info,
            _ => Severity.Error,
        });
    }

    private async Task DisconnectDrive()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Google Drive Bağlantısını Kes",
            "Otomatik bulut yedeği durur. Drive'daki mevcut yedekler silinmez. Devam edilsin mi?",
            yesText: "Bağlantıyı Kes", noText: "Vazgeç");
        if (confirm != true)
            return;

        await CloudBackup.DisconnectAsync();
        Snackbar.Add("Google Drive bağlantısı kesildi.", Severity.Info);
    }

    public void Dispose()
    {
        CloudBackup.StatusChanged -= OnCloudStatusChanged;
        connectCts?.Cancel();
    }

    private async Task PickGoldPriceTemplate()
    {
        var file = await FilePicker.PickFileAsync("Altın fiyatı şablon görseli seçin", ".jpg", ".jpeg", ".png");
        if (file == null)
            return;

        var bytes = await File.ReadAllBytesAsync(file.FullPath);
        if (bytes.Length > 5 * 1024 * 1024)
        {
            Snackbar.Add("Görsel 5 MB'tan küçük olmalıdır.", Severity.Warning);
            return;
        }

        settings.GoldPriceTemplateImage = bytes;
        Snackbar.Add("Şablon seçildi. Kalıcı olması için Kaydet'e basın.", Severity.Info);
    }

    private async Task BackupLocalNow()
    {
        isLocalBackupInProgress = true;
        try
        {
            var path = await BackupService.BackupNowAsync();
            if (path != null)
                Snackbar.Add("Yerel yedek alındı.", Severity.Success);
            else
                Snackbar.Add("Yedek alınamadı.", Severity.Error);
            RefreshLocalBackupInfo();
        }
        finally
        {
            isLocalBackupInProgress = false;
        }
    }

    private async Task OpenBackupFolder()
    {
        var latest = BackupService.GetBackupsList().FirstOrDefault();
        if (latest == null)
        {
            Snackbar.Add("Henüz yerel yedek yok.", Severity.Info);
            return;
        }
        await ShareService.ShareFileAsync(latest, "Yerel yedek");
    }

    private async Task ImportLegacyData()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Eski Verileri Aktar",
            "Eski sürümdeki müşteri, işlem ve ayarlarınız bu sürüme aktarılacak. Bu sürümde girdiğiniz veriler varsa üzerine yazılır.\n\nDevam edilsin mi?",
            yesText: "Aktar",
            noText: "Vazgeç");
        if (confirm != true || legacyDatabasePath == null)
            return;

        isRestoreInProgress = true;
        StateHasChanged();
        try
        {
            await BackupService.BackupNowAsync();
            var result = await DatabaseService.RestoreDatabaseAsync(legacyDatabasePath, keepCurrentSettingsAndLicense: false);
            if (result.Success)
            {
                LegacyDataLocator.MarkImported();
                await DialogService.ShowMessageBox("Başarılı", result.Message, yesText: "Tamam");
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                await DialogService.ShowMessageBox("Hata", result.Message, yesText: "Tamam");
            }
        }
        finally
        {
            isRestoreInProgress = false;
            StateHasChanged();
        }
    }

    private async Task RestoreDatabase()
    {
        var firstConfirm = await DialogService.ShowMessageBox(
            "Yedeği İçe Aktar",
            "Bu işlem mevcut TÜM müşteri, işlem ve stok verilerinizi seçeceğiniz yedek dosyasındaki verilerle değiştirecektir.\n\nDevam etmek istiyor musunuz?",
            yesText: "Evet, Devam Et",
            noText: "İptal");

        if (firstConfirm != true) return;

        try
        {
            var file = await FilePicker.PickFileAsync("Yedek dosyasını seçin (.db3)", ".db3", ".db");
            if (file == null) return;

            var finalConfirm = await DialogService.ShowMessageBox(
                "Son Onay",
                $"Seçilen dosya: {file.FileName}\n\nMevcut müşteri, işlem ve stok verileri bu dosyadakilerle değiştirilecek. Emin misiniz?",
                yesText: "Evet, İçe Aktar",
                noText: "Vazgeç");

            if (finalConfirm != true) return;

            isRestoreInProgress = true;
            StateHasChanged();

            // Geri dönüş imkânı için önce mevcut verinin yerel yedeğini al
            await BackupService.BackupNowAsync();

            var result = await DatabaseService.RestoreDatabaseAsync(file.FullPath);

            if (result.Success)
            {
                await DialogService.ShowMessageBox("Başarılı", result.Message, yesText: "Tamam");
                NavigationManager.NavigateTo("/");
            }
            else
            {
                await DialogService.ShowMessageBox("Hata", result.Message, yesText: "Tamam");
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBox("Hata", $"Dosya seçilirken bir hata oluştu: {ex.Message}", yesText: "Tamam");
        }
        finally
        {
            isRestoreInProgress = false;
            StateHasChanged();
        }
    }
}
