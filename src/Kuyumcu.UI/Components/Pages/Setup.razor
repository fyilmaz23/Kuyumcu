@page "/setup"
@layout Kuyumcu.Components.Layout.BareLayout
@inject DatabaseService DatabaseService
@inject NavigationManager NavigationManager
@inject AppState AppState
@inject ILegacyDataLocator LegacyDataLocator
@inject BackupService BackupService
@inject IDialogService DialogService

<div class="kd-card kd-gate">
    <div class="kd-gate-head">
        <div class="kd-gate-icon is-brand"><MudIcon Icon="@Icons.Material.Filled.Diamond" /></div>
        <div>
            <MudText Typo="Typo.h5" Class="kd-strong">Hoş geldiniz</MudText>
            <MudText Typo="Typo.body2" Class="kd-muted">Birkaç saniyede başlayın. 30 gün boyunca tüm özellikler ücretsiz açıktır.</MudText>
        </div>
    </div>

    @if (legacyDatabasePath != null)
    {
        <div class="kd-gate-option is-recommended">
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Outlined.MoveDown" Size="Size.Small" />
                <b>Eski sürümün verileri bulundu</b>
                <span class="kd-badge emanet">Önerilen</span>
            </div>
            <MudText Typo="Typo.body2" Class="kd-muted mb-3">
                Daha önce kullandığınız uygulamadaki müşteri, işlem ve ayarlarınız tek tıkla aktarılır. Eski uygulamaya dokunulmaz.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.MoveDown"
                       OnClick="ImportLegacyData" Disabled="@isImporting">
                @(isImporting ? "Aktarılıyor…" : "Eski Verileri Aktar")
            </MudButton>
        </div>

        <div class="kd-gate-divider"><span>veya yeni başlayın</span></div>
    }

    <MudTextField @bind-Value="settings.BusinessName"
                  Label="İş yeri adı"
                  Placeholder="Örn: Kuyumcu Mehmet"
                  Variant="Variant.Outlined"
                  Required="true"
                  RequiredError="İş yeri adı zorunludur"
                  HelperText="Google Drive yedeği ve altın fiyatı ayarlarını sonra Ayarlar'dan yapabilirsiniz."
                  Class="mb-4" />

    <MudButton Variant="@(legacyDatabasePath != null ? Variant.Outlined : Variant.Filled)"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               StartIcon="@Icons.Material.Filled.Check"
               OnClick="SaveAndContinue"
               Disabled="@(string.IsNullOrWhiteSpace(settings.BusinessName))">
        Kaydet ve Başla
    </MudButton>
</div>

@code {
    private AppSettings settings = new();
    private string? legacyDatabasePath;
    private bool isImporting;

    protected override async Task OnInitializedAsync()
    {
        settings = await DatabaseService.GetSettingsAsync();

        try
        {
            legacyDatabasePath = LegacyDataLocator.FindLegacyDatabase();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eski sürüm verisi aranırken hata: {ex.Message}");
        }

        // Kurulum zaten tamamlanmışsa (ör. yedekten geri yüklenmiş veri) ana sayfaya yönlendir
        if (settings.IsSetupCompleted)
        {
            AppState.IsSetupCompleted = true;
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task SaveAndContinue()
    {
        if (string.IsNullOrWhiteSpace(settings.BusinessName))
            return;

        settings.IsSetupCompleted = true;
        await DatabaseService.SaveSettingsAsync(settings);
        AppState.IsSetupCompleted = true;
        NavigationManager.NavigateTo("/");
    }

    private async Task ImportLegacyData()
    {
        if (legacyDatabasePath == null)
            return;

        isImporting = true;
        try
        {
            await BackupService.BackupNowAsync();
            var result = await DatabaseService.RestoreDatabaseAsync(legacyDatabasePath, keepCurrentSettingsAndLicense: false);
            if (!result.Success)
            {
                await DialogService.ShowMessageBox("Hata", result.Message, yesText: "Tamam");
                return;
            }

            LegacyDataLocator.MarkImported();

            var imported = await DatabaseService.GetSettingsAsync();
            if (!imported.IsSetupCompleted || string.IsNullOrWhiteSpace(imported.BusinessName))
            {
                // Eski veride iş yeri adı yoksa formu doldurmaya devam etsin
                settings = imported;
                legacyDatabasePath = null;
                return;
            }

            await DialogService.ShowMessageBox("Başarılı", result.Message, yesText: "Tamam");
            AppState.IsSetupCompleted = true;
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            isImporting = false;
        }
    }
}
