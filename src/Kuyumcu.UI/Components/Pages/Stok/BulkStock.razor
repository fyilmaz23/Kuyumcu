@page "/stock/bulk"
@using Kuyumcu.Stock
@inject StockService Stock
@inject DatabaseService Database
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<div class="kd-page">
    <PageHeader Title="Kasa" Subtitle="Etiketlenmeyen mallar ve nakit: çeyrek, yarım, tam, gram altın, TL ve döviz. Müşteri defterine girilen Gelen kasaya girer, Giden çıkar (emanet hariç).">
        <Actions>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Settings" Href="/settings#stok-tanimlari">Ürünleri düzenle</MudButton>
        </Actions>
    </PageHeader>

    @if (rows == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        var gold = rows.Where(r => r.Product.Unit != BulkUnit.Money).ToList();
        var money = rows.Where(r => r.Product.Unit == BulkUnit.Money).ToList();

        <div class="kd-kpis">
            <div class="kd-kpi">
                <span class="kd-kpi-label">Altın toplamı (has)</span>
                <span class="kd-kpi-value">@WeightFormat.Gram2(gold.Sum(r => r.HasMg)) <small>gr</small></span>
                <span class="kd-kpi-hint">@WeightFormat.Gram2(gold.Sum(r => r.WeightMg)) gr brüt</span>
            </div>
            @foreach (var r in money.Where(r => r.Product.Amount != 0))
            {
                <div class="kd-kpi @(r.Product.Amount < 0 ? "is-giden" : "is-gelen")">
                    <span class="kd-kpi-label">@r.Product.Name</span>
                    <span class="kd-kpi-value">@StockService.FormatBulkAmount(r.Product, r.Product.Amount)</span>
                    <span class="kd-kpi-hint">@(r.Product.Amount < 0 ? "eksi: açılış miktarını Sayım ile girin" : "kasada")</span>
                </div>
            }
        </div>

        @if (!rows.Any())
        {
            <div class="kd-card"><EmptyState Icon="@Icons.Material.Outlined.Savings" Title="Kasa ürünü tanımlı değil" Text="Ayarlar → Stok tanımları bölümünden ekleyin." /></div>
        }
        else
        {
            <div class="kd-bulk-groups">
                @Group("Altın ve sarrafiye", Icons.Material.Outlined.Savings, gold)
                @Group("Nakit ve döviz", Icons.Material.Outlined.Payments, money)
            </div>
        }
    }
</div>

@code {
    private List<BulkTotal>? rows;
    private int? expanded;
    private List<StockMovement> history = new();

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        var karats = await Stock.GetKaratsAsync(true);
        rows = (await Stock.GetBulkProductsAsync()).Select(p => StockCalculator.CalculateBulk(p, karats)).ToList();
        if (expanded.HasValue)
            await LoadHistory(expanded.Value);
    }

    private RenderFragment Group(string title, string icon, List<BulkTotal> list) =>
        @<section class="kd-card">
            <div class="kd-card-header">
                <div class="kd-card-title"><MudIcon Icon="@icon" /> @title</div>
            </div>
            @if (list.Count == 0)
            {
                <div class="kd-muted pa-4" style="font-size:.85rem">Bu grupta ürün yok.</div>
            }
            @foreach (var r in list)
            {
                var p = r.Product;
                <div class="kd-list-row kd-spread kd-bulk-row">
                    <div style="min-width:0">
                        <div class="kd-strong">@p.Name</div>
                        <div class="kd-muted" style="font-size:.78rem">
                            @(p.Unit switch { BulkUnit.Piece => $"{p.Karat} ayar · adedi {WeightFormat.Gram(p.PieceWeightMg)} gr", BulkUnit.Gram => $"{p.Karat} ayar · gramla", _ => "nakit" })
                            @if (p.LedgerCurrencyType is { } lc)
                            {
                                <span title="Müşteri defterindeki bu cins buraya işlenir"> · <MudIcon Icon="@Icons.Material.Outlined.Link" Style="font-size:.85rem; vertical-align:-2px" /> defter: @lc.GetShortName()</span>
                            }
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="kd-num kd-strong @(p.Amount < 0 ? "kd-giden" : null)" style="font-size:1.1rem">@StockService.FormatBulkAmount(p, p.Amount)</div>
                        @if (p.Unit != BulkUnit.Money)
                        {
                            <div class="kd-muted kd-num" style="font-size:.76rem">@WeightFormat.Gram2(r.WeightMg) gr · has @WeightFormat.Gram2(r.HasMg) gr</div>
                        }
                    </div>
                    <div class="d-flex gap-1 align-center">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => Move(p, StockMovementType.BulkIn))">Giriş</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => Move(p, StockMovementType.BulkOut))">Çıkış</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Move(p, StockMovementType.BulkAdjust))">Sayım</MudButton>
                        <MudIconButton Icon="@(expanded == p.Id ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.History)" Size="Size.Small"
                                       OnClick="@(() => ToggleHistory(p.Id))" aria-label="Hareketler" />
                    </div>
                </div>
                @if (expanded == p.Id)
                {
                    <div class="kd-bulk-history">
                        @if (!history.Any())
                        {
                            <div class="kd-muted pa-3" style="font-size:.85rem">Hareket yok.</div>
                        }
                        @foreach (var m in history)
                        {
                            <div class="d-flex justify-space-between align-center gap-3 py-1">
                                <span class="kd-muted kd-num" style="font-size:.8rem; width:120px">@m.Date.ToString("dd.MM.yyyy HH:mm")</span>
                                <span style="flex:1; min-width:0">
                                    @if (m.FromLedger)
                                    {
                                        <span class="kd-badge notr mr-1" title="Müşteri defterinden otomatik">Defter</span>
                                    }
                                    @m.Description
                                    @if (IsReturned(m))
                                    {
                                        <span class="kd-muted" style="font-size:.8rem"> · iade alındı</span>
                                    }
                                </span>
                                @if (m.CustomerId is { } cid && m.FromLedger)
                                {
                                    <MudIconButton Icon="@Icons.Material.Outlined.Person" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/customer/{cid}"))"
                                                   aria-label="Müşteri hesabını aç" />
                                }
                                @if (IsReturnable(m))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AssignmentReturn"
                                               OnClick="@(() => ReturnSale(p, m))">İade al</MudButton>
                                }
                                <span class="kd-num kd-strong @(m.AmountDelta >= 0 ? "kd-gelen" : "kd-giden")">
                                    @(m.AmountDelta >= 0 ? "+" : "−")@StockService.FormatBulkAmount(p, Math.Abs(m.AmountDelta))
                                </span>
                            </div>
                        }
                    </div>
                }
            }
        </section>;

    private async Task Move(BulkProduct product, StockMovementType type)
    {
        var saved = await BulkMovementDialog.ShowAsync(Dialogs, product, type);
        if (saved == null)
            return;
        Snackbar.Add($"{saved.Name}: {StockService.FormatBulkAmount(saved, saved.Amount)}", Severity.Success);
        await Reload();
    }

    // Müşteri hesabına yazılmış (veresiye) kasa satışı, henüz iade alınmadıysa iade alınabilir. Defterden gelen hareket alınamaz.
    private bool IsReturned(StockMovement m) => history.Any(r => r.RelatedMovementId == m.Id);
    private bool IsReturnable(StockMovement m) =>
        m.Type == StockMovementType.BulkOut && m.CustomerId.HasValue && !m.FromLedger && !IsReturned(m);

    private async Task ReturnSale(BulkProduct product, StockMovement sale)
    {
        var hasTransaction = sale.TransactionId.HasValue && sale.CustomerId.HasValue;
        var prompt = await TextPromptDialog.ShowAsync(Dialogs, "İade al",
            $"{StockService.FormatBulkAmount(product, Math.Abs(sale.AmountDelta))} {product.Name} kasaya geri alınacak.",
            label: "İade açıklaması", confirmText: "İade al",
            checkboxText: hasTransaction ? "Müşteri hesabına yazılan satış işlemini de sil" : null, checkboxValue: hasTransaction);
        if (prompt == null)
            return;

        try
        {
            var saved = await Stock.ReturnBulkSaleAsync(sale.Id, string.IsNullOrWhiteSpace(prompt.Text) ? null : prompt.Text);
            var deleted = false;
            if (prompt.Checked && hasTransaction)
            {
                var transaction = (await Database.GetCustomerTransactionsAsync(sale.CustomerId!.Value))
                    .FirstOrDefault(t => t.Id == sale.TransactionId!.Value);
                if (transaction != null)
                {
                    await Database.DeleteTransactionAsync(transaction);
                    deleted = true;
                }
            }
            Snackbar.Add($"İade alındı. {saved.Name}: {StockService.FormatBulkAmount(saved, saved.Amount)}"
                + (deleted ? " Müşteri hesabındaki satış işlemi silindi." : ""), Severity.Success);
            await Reload();
        }
        catch (StockException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task ToggleHistory(int id)
    {
        expanded = expanded == id ? null : id;
        if (expanded.HasValue)
            await LoadHistory(id);
        else
            history = new();
    }

    private async Task LoadHistory(int id) => history = await Stock.GetBulkMovementsAsync(id);
}
