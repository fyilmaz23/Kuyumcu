@page "/transactions"
@inject DatabaseService DatabaseService
@inject NavigationManager NavigationManager

<div class="kd-page">
    <PageHeader Title="İşlemler" Subtitle="Tüm müşterilerin hareketleri ve takip gerektiren borçlar" />

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" Color="Color.Transparent"
             SliderColor="Color.Primary" ActiveTabClass="kd-strong">
        <MudTabPanel Text="Tüm İşlemler" Icon="@Icons.Material.Outlined.ReceiptLong">
            <div class="kd-card">
                <div class="kd-card-header">
                    <MudChipSet T="TransactionType?" SelectedValue="filterType" SelectedValueChanged="OnFilterTypeChanged"
                                SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Variant="Variant.Text" Color="Color.Primary">
                        <MudChip T="TransactionType?" Value="@((TransactionType?)null)" Default="true">Tümü</MudChip>
                        <MudChip T="TransactionType?" Value="@(TransactionType.CustomerDebt)">Giden</MudChip>
                        <MudChip T="TransactionType?" Value="@(TransactionType.StoreDebt)">Gelen</MudChip>
                    </MudChipSet>
                    <MudText Typo="Typo.caption" Class="kd-muted">Satıra tıklayarak müşterinin hesabını açın.</MudText>
                </div>
                <MudTable T="Transaction" ServerData="ServerReload" @ref="table" Class="kd-table" Elevation="0"
                          Hover="true" Breakpoint="Breakpoint.Sm" OnRowClick="OnRowClick" RowClass="kd-row-link"
                          LoadingProgressColor="Color.Primary">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortLabel="date" T="Transaction" InitialDirection="MudBlazor.SortDirection.Descending">Tarih</MudTableSortLabel></MudTh>
                        <MudTh>Müşteri</MudTh>
                        <MudTh><MudTableSortLabel SortLabel="type" T="Transaction">Tür</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="currency" T="Transaction">Cins</MudTableSortLabel></MudTh>
                        <MudTh Class="kd-right"><MudTableSortLabel SortLabel="amount" T="Transaction">Tutar</MudTableSortLabel></MudTh>
                        <MudTh>Açıklama</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tarih" Class="kd-num">
                            @context.Date.ToString("dd.MM.yyyy") <span class="kd-muted" style="font-size:.75rem">@context.Date.ToString("HH:mm")</span>
                        </MudTd>
                        <MudTd DataLabel="Müşteri">
                            @{ var name = customerNames.TryGetValue(context.CustomerId, out var n) ? n : "Bilinmeyen müşteri"; }
                            <div class="d-flex align-center gap-2">
                                <Avatar Name="@name" />
                                <span class="kd-strong">@name</span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Tür"><TypeBadge Type="context.Type" IsDeposit="context.IsDeposit" /></MudTd>
                        <MudTd DataLabel="Cins">@context.CurrencyType.GetDisplayName()</MudTd>
                        <MudTd DataLabel="Tutar" Class="kd-right kd-num kd-strong">@FormatHelper.FormatPrice(context.Amount) @context.CurrencyType.GetSymbol()</MudTd>
                        <MudTd DataLabel="Açıklama" Class="kd-muted">@context.Description</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong" Title="İşlem bulunamadı" />
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager RowsPerPageString="Sayfa başına:" InfoFormat="{first_item}-{last_item} / {all_items}" PageSizeOptions="new[] { 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="@(customersWithLongDebt.Count > 0 ? $"Uzun Süreli Borçlar ({customersWithLongDebt.Count})" : "Uzun Süreli Borçlar")" Icon="@Icons.Material.Outlined.HourglassBottom">
            <div class="kd-card">
                <div class="kd-card-header">
                    <MudText Typo="Typo.body2" Class="kd-muted">30 günden uzun süredir giden bakiyesi kapanmamış hesaplar (en eskisi en üstte).</MudText>
                </div>
                @if (isLoading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (customersWithLongDebt.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.TaskAlt" Title="Uzun süreli borç yok" />
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="kd-table">
                        <thead>
                            <tr>
                                <th>Müşteri</th>
                                <th>Borç başlangıcı</th>
                                <th>Süre</th>
                                <th>Cins</th>
                                <th class="kd-right">Bakiye</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in customersWithLongDebt)
                            {
                                <tr class="kd-clickable" @onclick="@(() => ViewCustomerDetails(d.CustomerId))">
                                    <td>
                                        <div class="d-flex align-center gap-2"><Avatar Name="@d.CustomerName" /><span class="kd-strong">@d.CustomerName</span></div>
                                    </td>
                                    <td class="kd-num">@d.EarliestDebtDate.ToString("dd.MM.yyyy")</td>
                                    <td><span class="kd-badge @((DateTime.Now - d.EarliestDebtDate).TotalDays >= 90 ? "giden" : "notr")">@GetDebtDurationText(d.EarliestDebtDate)</span></td>
                                    <td>@d.CurrencyType.GetDisplayName()</td>
                                    <td class="kd-right"><BalanceAmount Balance="d.Balance" Currency="d.CurrencyType" ShowDirection="false" Class="kd-strong" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Tüm Kalemlerde Borçlu" Icon="@Icons.Material.Outlined.PersonSearch">
            <div class="kd-card">
                <div class="kd-card-header">
                    <MudText Typo="Typo.body2" Class="kd-muted">İşlem yaptığı her cinste giden bakiyesi olan müşteriler.</MudText>
                </div>
                @if (isLoading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (customersWithPositiveBalance.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.TaskAlt" Title="Tüm kalemlerde borçlu müşteri yok" />
                }
                else
                {
                    @foreach (var c in customersWithPositiveBalance)
                    {
                        <div class="kd-list-row kd-clickable" @onclick="@(() => ViewCustomerDetails(c.CustomerId))">
                            <Avatar Name="@c.CustomerName" />
                            <div style="flex:1" class="kd-strong">@c.CustomerName</div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="kd-muted" />
                        </div>
                    }
                }
            </div>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private List<Transaction> transactions = new();
    private Dictionary<int, string> customerNames = new();
    private bool isLoading = true;
    private TransactionType? filterType;
    private string searchTerm = string.Empty;
    private List<CustomerDebtInfo> customersWithLongDebt = new();
    private List<CustomerDebtInfo> customersWithPositiveBalance = new();
    private MudTable<Transaction>? table;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var customers = await DatabaseService.GetCustomersAsync();
        customerNames = customers.ToDictionary(c => c.Id, c => c.Name);

        // Özet hesapları emanetler hariç tüm işlemler üzerinden yapılır
        transactions = (await DatabaseService.GetTransactionsAsync()).Where(t => !t.IsDeposit).ToList();
        CalculateCustomersWithLongDebt(customers);
        CalculateCustomersWithPositiveBalance(customers);

        isLoading = false;
    }

    private async Task<TableData<Transaction>> ServerReload(TableState state, CancellationToken cancellationToken = default)
    {
        try
        {
            var page = await DatabaseService.GetTransactionsPaginationAsync(
                state.Page, state.PageSize, state.SortLabel, Helper.HelperMethods.GetSortDirection(state.SortDirection), searchTerm, filterType);
            var total = await DatabaseService.GetTransactionCountAsync(searchTerm, filterType);

            foreach (var t in page.Where(t => t.CustomerId > 0 && !customerNames.ContainsKey(t.CustomerId)))
            {
                var customer = await DatabaseService.GetCustomerAsync(t.CustomerId);
                if (customer != null)
                    customerNames[t.CustomerId] = customer.Name;
            }

            return new TableData<Transaction> { Items = page, TotalItems = total };
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            return new TableData<Transaction> { Items = new List<Transaction>(), TotalItems = 0 };
        }
    }

    /// <summary>İşlem yaptığı her para biriminde giden bakiyesi olan müşteriler.</summary>
    private void CalculateCustomersWithPositiveBalance(List<Customer> customers)
    {
        customersWithPositiveBalance = customers
            .Where(customer =>
            {
                var byCurrency = transactions.Where(t => t.CustomerId == customer.Id).GroupBy(t => t.CurrencyType).ToList();
                return byCurrency.Count > 0 && byCurrency.All(g =>
                    g.Where(t => t.Type == TransactionType.CustomerDebt).Sum(t => t.Amount) -
                    g.Where(t => t.Type == TransactionType.StoreDebt).Sum(t => t.Amount) > 0);
            })
            .Select(c => new CustomerDebtInfo { CustomerId = c.Id, CustomerName = c.Name })
            .ToList();
    }

    /// <summary>
    /// Giden bakiyesi 30 günden uzun süredir kapanmamış hesaplar. Borç başlangıcı, kümülatif bakiyenin
    /// en son sıfırın üstüne çıktığı işlemin tarihidir.
    /// </summary>
    private void CalculateCustomersWithLongDebt(List<Customer> customers)
    {
        var result = new List<CustomerDebtInfo>();

        foreach (var customer in customers)
        {
            foreach (var group in transactions.Where(t => t.CustomerId == customer.Id).GroupBy(t => t.CurrencyType))
            {
                var netBalance = group.Where(t => t.Type == TransactionType.CustomerDebt).Sum(t => t.Amount) -
                                 group.Where(t => t.Type == TransactionType.StoreDebt).Sum(t => t.Amount);
                if (netBalance <= 0)
                    continue;

                var earliestDebtDate = DateTime.MaxValue;
                decimal running = 0;
                foreach (var t in group.OrderBy(t => t.Date))
                {
                    running += t.Type == TransactionType.CustomerDebt ? t.Amount : -t.Amount;
                    if (running > 0 && earliestDebtDate == DateTime.MaxValue)
                        earliestDebtDate = t.Date;
                    else if (running <= 0)
                        earliestDebtDate = DateTime.MaxValue;
                }

                if (earliestDebtDate != DateTime.MaxValue && (DateTime.Now - earliestDebtDate).TotalDays >= 30)
                {
                    result.Add(new CustomerDebtInfo
                    {
                        CustomerId = customer.Id,
                        CustomerName = customer.Name,
                        Balance = netBalance,
                        EarliestDebtDate = earliestDebtDate,
                        CurrencyType = group.Key
                    });
                }
            }
        }

        customersWithLongDebt = result.OrderBy(c => c.EarliestDebtDate).ToList();
    }

    private void OnRowClick(TableRowClickEventArgs<Transaction> args)
    {
        if (args?.Item != null)
            ViewCustomerDetails(args.Item.CustomerId);
    }

    private void ViewCustomerDetails(int customerId) => NavigationManager.NavigateTo($"/customer/{customerId}");

    private static string GetDebtDurationText(DateTime debtDate)
    {
        var duration = DateTime.Now - debtDate;
        if (duration.TotalDays >= 365)
            return $"{(int)(duration.TotalDays / 365)} yıl, {(int)(duration.TotalDays % 365 / 30)} ay";
        if (duration.TotalDays >= 30)
            return $"{(int)(duration.TotalDays / 30)} ay, {(int)(duration.TotalDays % 30)} gün";
        return $"{(int)duration.TotalDays} gün";
    }

    private async Task OnFilterTypeChanged(TransactionType? value)
    {
        filterType = value;
        if (table != null)
            await table.ReloadServerData();
    }

    private sealed class CustomerDebtInfo
    {
        public int CustomerId { get; set; }
        public string CustomerName { get; set; } = string.Empty;
        public decimal Balance { get; set; }
        public DateTime EarliestDebtDate { get; set; }
        public CurrencyType CurrencyType { get; set; } = CurrencyType.TurkishLira;
    }
}
