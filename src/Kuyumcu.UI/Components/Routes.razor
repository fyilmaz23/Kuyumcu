@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@inject Kuyumcu.Services.LicenseService LicenseService
@inject Kuyumcu.Services.DatabaseService DatabaseService
@inject AppState AppState

@if (!AppState.IsLoaded)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;color:#777;">
        Yükleniyor...
    </div>
}
else
{
<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        @if (!AppState.IsSetupCompleted && routeData.PageType != typeof(Pages.Setup))
        {
            NavigationManager.NavigateTo("setup");
            return;
        }
        else if (AppState.IsLicenseExpired
                 && routeData.PageType != typeof(Pages.LicenseExpired)
                 && routeData.PageType != typeof(Pages.Settings)
                 && routeData.PageType != typeof(Pages.Setup)
                 // Geliştirici aracı (gitignore'da, yayın derlemesinde yok): süre dolmuşken anahtar üretebilmek için
                 && routeData.PageType.Name != "LicenseKeyGenerator")
        {
            NavigationManager.NavigateTo("license-expired");
            return;
        }

        @if (!AppState.HasBarcodeModule && BarcodeModuleLocked.IsBarcodePage(routeData.PageType))
        {
            @* Barkod modülü olmayan lisansta stok sayfalarının yerine tanıtım/iletişim ekranı (menü ve kısayollar aynı kalır) *@
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <BarcodeModuleLocked />
            </LayoutView>
        }
        else
        {
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        }
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <div class="kd-page">
                <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="Sayfa bulunamadı" Text="Aradığınız sayfa mevcut değil.">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">Ana Sayfaya Dön</MudButton>
                </EmptyState>
            </div>
        </LayoutView>
    </NotFound>
</Router>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        if (AppState.IsLoaded)
            return;

        try
        {
            AppState.IsSetupCompleted = await DatabaseService.IsSetupCompletedAsync();
            AppState.ApplyLicense(await LicenseService.GetLicenseStateAsync());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Routes başlangıç kontrolü hata: {ex.Message}");
            AppState.IsLicenseExpired = false; // Hata durumunda engelleme
            AppState.HasBarcodeModule = false; // ek ücretli modül: hata durumunda kapalı
        }
        finally
        {
            AppState.IsLoaded = true;
        }
    }
}
