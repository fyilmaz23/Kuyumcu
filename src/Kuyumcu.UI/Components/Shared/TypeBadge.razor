@* İşlem türü rozeti: Giden / Gelen / Emanet / Emanet teslimi *@
@if (IsDeposit && Type == TransactionType.CustomerDebt)
{
    <span class="kd-badge emanet"><MudIcon Icon="@Icons.Material.Filled.LockOpen" Style="font-size:.85rem" />Emanet teslimi</span>
}
else if (IsDeposit)
{
    <span class="kd-badge emanet"><MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:.85rem" />Emanet</span>
}
else if (Type == TransactionType.CustomerDebt)
{
    <span class="kd-badge giden"><MudIcon Icon="@Icons.Material.Filled.NorthEast" Style="font-size:.85rem" />Giden</span>
}
else
{
    <span class="kd-badge gelen"><MudIcon Icon="@Icons.Material.Filled.SouthWest" Style="font-size:.85rem" />Gelen</span>
}

@code {
    [Parameter] public TransactionType Type { get; set; }
    [Parameter] public bool IsDeposit { get; set; }
}
