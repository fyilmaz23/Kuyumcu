<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Ortak arayüz: Razor sayfaları, tema ve stiller. Windows ve Android uygulamaları birlikte kullanır. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kuyumcu</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuyumcu.Core\Kuyumcu.Core.csproj" />
  </ItemGroup>

  <!-- Geliştiricinin yerel lisans üretme sayfası (gitignore'da) yayın derlemesine girmez: Core'un karıştırılan iç
       lisans sınıflarını kullanır ve müşteriye gönderilen uygulamada olmamalı. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="Components\Pages\LicenseKeyGenerator.razor" />
    <RazorComponent Remove="Components\Pages\LicenseKeyGenerator.razor" />
  </ItemGroup>
</Project>
