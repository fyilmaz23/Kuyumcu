<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platformdan bağımsız iş mantığının birim testleri: dotnet test tests/Kuyumcu.Core.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Kuyumcu.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- CI testleri Linux'ta koşar: SkiaSharp paketi Linux yerel kütüphanesini (libSkiaSharp.so) içermez -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kuyumcu.Core\Kuyumcu.Core.csproj" />
  </ItemGroup>
</Project>
